---
// Team section. PolygonScan asks for founder/team information with public
// LinkedIn profiles, so this is a submission requirement, not decoration.
//
// The section renders nothing at all while `team` is empty — no heading, no
// empty cards, no invented names. See data/team.ts.
import { team } from "../data/team";
import { ui } from "../i18n";
import T from "./T.astro";
---
{team.length > 0 && (
  <section id="team" class="relative mx-auto w-full max-w-[1376px] mb-4 rounded-2xl border border-white/[0.07] bg-[#0f0f0f] overflow-hidden">
    <div class="relative px-6 sm:px-10 lg:px-11 py-12 lg:py-[52px] flex flex-col gap-10">
      <div class="flex flex-col gap-4 items-start max-w-[640px]">
        <span
          class="inline-flex items-center gap-3 pl-2 pr-5 py-2 rounded-full text-white text-base font-medium font-tight"
          style="background-image:linear-gradient(90deg,rgba(239,183,79,0.4) 0%,rgba(98,0,0,0) 100%)"
        >
          <span class="w-7 h-7 rounded-full bg-[#F7A100] flex items-center justify-center text-white shrink-0">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M10 10a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm11 10v-2a4 4 0 0 0-3-3.87M16 3.13A4 4 0 0 1 16 11" />
            </svg>
          </span>
          <T t={ui.team.eyebrow} />
        </span>
        <h2 class="font-serif font-medium text-4xl sm:text-5xl lg:text-[56px] lg:leading-[60px] tracking-tight bg-[linear-gradient(180deg,#fff_0%,rgba(255,255,255,0.4)_100%)] bg-clip-text text-transparent">
          <span class="block"><T t={ui.team.heading1} /></span>
          <span class="block"><T t={ui.team.heading2} /></span>
        </h2>
        <p class="text-white/80 text-base leading-[26px]"><T t={ui.team.sub} /></p>
      </div>

      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 list-none p-0 m-0">
        {team.map((member) => (
          <li class="rounded-2xl border border-white/[0.07] bg-[#0c0c0c] overflow-hidden flex flex-col">
            <img
              src={member.photo}
              alt={member.name}
              width="480"
              height="480"
              loading="lazy"
              class="w-full aspect-square object-cover"
            />
            <div class="flex flex-col gap-1.5 p-5">
              <h3 class="text-white font-medium text-lg leading-tight">{member.name}</h3>
              <p class="text-white/70 text-sm leading-5"><T t={member.role} /></p>
              <a
                href={member.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-2 inline-flex w-fit items-center gap-2 text-gold hover:text-gold-light text-sm font-medium no-underline transition-colors"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
                <T t={ui.team.linkedin} />
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
