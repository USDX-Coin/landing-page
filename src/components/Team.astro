---
// Team section on the landing page. The nav entry next to the whitepaper is an
// anchor to "#team" (see data/navigation.ts), so this is what it scrolls to.
//
// The section renders nothing at all while `team` is empty — no heading, no
// empty cards, no invented names. See data/team.ts.
//
// Card layout: the photo fills the card and name/role/profile sit on a scrim
// over its lower edge — the same pattern the Case Study cards use, so the two
// read as one system.
import { team } from "../data/team";
import { socialIconPaths } from "../data/icons";
import { ui } from "../i18n";
import T from "./T.astro";
---
{team.length > 0 && (
  <section id="team" class="relative mx-auto w-full max-w-[1376px] mb-4 rounded-2xl border border-white/[0.07] bg-[#0f0f0f] overflow-hidden scroll-mt-24">
    <!-- red glow, same treatment as the other section headers -->
    <div class="absolute -top-20 right-10 w-[560px] h-[240px] bg-[#b60000]/20 blur-[130px] rounded-[50%] pointer-events-none"></div>

    <div class="relative px-6 sm:px-10 lg:px-11 py-12 lg:py-[52px] flex flex-col gap-10">
      <div class="flex flex-col gap-4 items-start max-w-[640px]">
        <span
          class="inline-flex items-center gap-3 pl-2 pr-5 py-2 rounded-full text-white text-base font-medium font-tight"
          style="background-image:linear-gradient(90deg,rgba(239,183,79,0.4) 0%,rgba(98,0,0,0) 100%)"
        >
          <span class="w-7 h-7 rounded-full bg-[#F7A100] flex items-center justify-center text-white shrink-0">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M10 10a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm11 10v-2a4 4 0 0 0-3-3.87M16 3.13A4 4 0 0 1 16 11" />
            </svg>
          </span>
          <T t={ui.team.eyebrow} />
        </span>
        <h2 class="font-serif font-medium text-4xl sm:text-5xl lg:text-[56px] lg:leading-[60px] tracking-tight bg-[linear-gradient(180deg,#fff_0%,rgba(255,255,255,0.4)_100%)] bg-clip-text text-transparent m-0">
          <span class="block"><T t={ui.team.heading1} /></span>
          <span class="block"><T t={ui.team.heading2} /></span>
        </h2>
        <p class="text-white/80 text-base leading-[26px] m-0"><T t={ui.team.sub} /></p>
      </div>

      <!-- auto-fit keeps a single member from stretching across the section and
           fills the row on its own as more are added -->
      <ul class="grid gap-4 grid-cols-1 justify-center sm:grid-cols-[repeat(auto-fit,minmax(240px,300px))] list-none p-0 m-0">
        {team.map((member) => (
          <li class="group relative rounded-2xl border border-white/[0.07] overflow-hidden transition-transform duration-300 lg:hover:-translate-y-1">
            <img
              src={member.photo}
              alt={member.name}
              width="960"
              height="960"
              loading="lazy"
              decoding="async"
              class="w-full aspect-square object-cover transition-transform duration-500 group-hover:scale-[1.04]"
            />
            <div class="absolute inset-x-0 bottom-0 p-5 pt-16 bg-gradient-to-t from-black via-black/80 to-transparent flex flex-col gap-1.5">
              <h3 class="text-white font-medium text-lg leading-tight m-0">{member.name}</h3>
              <p class="text-white/70 text-sm leading-5 m-0"><T t={member.role} /></p>
              <a
                href={member.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-2 inline-flex items-center justify-center w-9 h-9 rounded-lg border border-white/15 bg-white/[0.08] text-white/80 hover:text-gold hover:border-gold/40 hover:bg-white/[0.12] transition-colors no-underline"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d={socialIconPaths.instagram} />
                </svg>
                <span class="sr-only">{member.name} — <T t={ui.team.instagram} /></span>
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
