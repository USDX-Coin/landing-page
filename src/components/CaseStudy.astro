---
import { caseStudies } from "../data/caseStudies";
import { APP_URL } from "../data/navigation";
import { ui } from "../i18n";
import T from "./T.astro";
---
<section id="case-study" class="relative mx-auto w-full max-w-[1376px] mb-4 rounded-2xl overflow-hidden border border-white/[0.07]">
  <!-- red branded background -->
  <!-- red gradient (Figma: brighter maroon top -> dark bottom) + grid at the bottom -->
  <div class="absolute inset-0 bg-[#0f0f0f]"></div>
  <div class="absolute inset-0 bg-[linear-gradient(to_top,#220004_0%,#7a0d10_100%)]"></div>
  <!-- perspective "floor" grid receding toward a horizon (per Figma) -->
  <div class="absolute inset-x-0 bottom-0 h-[55%] overflow-hidden pointer-events-none" style="perspective: 340px;">
    <div class="absolute left-1/2 bottom-0 w-[220%] -translate-x-1/2 h-[170%] origin-bottom" style="transform: rotateX(67deg); background-image: linear-gradient(rgba(255,255,255,0.14) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.14) 1px, transparent 1px); background-size: 48px 48px; mask-image: linear-gradient(to top, rgba(0,0,0,0.85), transparent 72%); -webkit-mask-image: linear-gradient(to top, rgba(0,0,0,0.85), transparent 72%);"></div>
  </div>

  <div class="relative px-6 sm:px-10 lg:px-11 py-12 lg:py-[52px] flex flex-col gap-10">
    <!-- Heading -->
    <div data-cs-head class="text-center max-w-[640px] mx-auto flex flex-col items-center gap-4">
      <span class="inline-flex items-center gap-3 pl-2 pr-5 py-2 rounded-full text-white text-base font-medium font-tight" style="background-image:linear-gradient(90deg,rgba(239,183,79,0.4) 0%,rgba(98,0,0,0) 100%)">
        <span class="w-7 h-7 rounded-full bg-[#F7A100] flex items-center justify-center text-white shrink-0">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19V5m0 14h16M8 16V9m4 7V6m4 10v-4" /></svg>
        </span>
        <T t={ui.caseStudy.eyebrow} />
      </span>
      <h2 class="font-serif font-medium text-4xl sm:text-5xl lg:text-[56px] lg:leading-[60px] tracking-tight bg-[linear-gradient(180deg,#fff_0%,rgba(255,255,255,0.55)_100%)] bg-clip-text text-transparent">
        <span class="block"><T t={ui.caseStudy.heading1} /></span>
        <span class="block"><T t={ui.caseStudy.heading2} /></span>
      </h2>
    </div>

    <!-- Horizontal scroll track (panned by scroll on desktop, swipe on mobile) -->
    <div data-cs-wrap class="overflow-x-auto lg:overflow-hidden scrollbar-hide -mx-6 px-6 sm:-mx-10 sm:px-10 lg:mx-0 lg:px-0 snap-x snap-mandatory lg:snap-none">
      <div data-cs-track class="flex gap-4 w-max">
        {caseStudies.map((cs) => (
          <article class="relative shrink-0 w-[300px] sm:w-[418px] h-[440px] sm:h-[488px] rounded-2xl overflow-hidden snap-center">
            <img src={cs.image} alt={cs.title.en} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
            <!-- top scrim + category tag -->
            <div class="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-black/60 to-transparent pointer-events-none"></div>
            {/* `{cs.tag.id}` here printed the Indonesian tag in both languages,
                so the English page read "Penyelesaian Lintas Negara" above an
                English title. `tag` is Translated like every other string on the
                site and renders through <T>. */}
            <span class="absolute top-4 left-4 inline-flex items-center px-4 py-1.5 rounded-full bg-black/60 backdrop-blur-sm border border-white/10 text-white text-sm font-medium font-tight">
              <T t={cs.tag} />
            </span>
            <!-- bottom scrim + text -->
            <div class="absolute inset-x-0 bottom-0 p-6 pt-16 bg-gradient-to-t from-black via-black/80 to-transparent flex flex-col gap-2">
              <h3 class="text-white font-medium text-xl leading-tight"><T t={cs.title} /></h3>
              <p class="text-white/75 text-base leading-[26px]"><T t={cs.description} /></p>
            </div>
          </article>
        ))}
      </div>
    </div>

    {/* Closing "Important Notice" from the official Use Cases page. It sits with
        the cards on purpose: the use cases above must never be read as an offer
        of domestic Indonesian payments. */}
    <div class="rounded-xl border border-white/15 bg-black/25 px-5 py-4 flex flex-col gap-1.5">
      <h3 class="text-white text-sm font-semibold m-0"><T t={ui.caseStudy.noticeTitle} /></h3>
      <p class="text-white/75 text-sm leading-6 m-0 max-w-[900px]"><T t={ui.caseStudy.notice} /></p>
    </div>

    <!-- divider -->
    <div class="h-px bg-white/15"></div>

    <!-- Bottom CTA row -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <h3 class="font-medium text-2xl sm:text-[28px] leading-tight max-w-[512px] bg-[linear-gradient(180deg,#fff_0%,rgba(255,255,255,0.55)_100%)] bg-clip-text text-transparent">
        <T t={ui.caseStudy.ctaHeading} />
      </h3>
      <div class="flex items-center gap-4 shrink-0">
        <!-- "More case studies" button removed until an articles page exists —
             it pointed at "#", which explorer reviewers flag as a placeholder. -->
        <a href={APP_URL} data-app-link target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-primary hover:bg-primary-dark text-white text-sm font-medium transition-colors no-underline">
          <T t={ui.cta} />
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduced) {
    gsap.from("[data-cs-head] > *", {
      y: 24, opacity: 0, duration: 0.7, ease: "power3.out", stagger: 0.1,
      scrollTrigger: { trigger: "[data-cs-head]", start: "top 85%" },
    });

    // Desktop: pan the card track sideways as the section scrolls through view.
    const mm = gsap.matchMedia();
    mm.add("(min-width: 1024px)", () => {
      const track = document.querySelector<HTMLElement>("[data-cs-track]");
      const wrap = document.querySelector<HTMLElement>("[data-cs-wrap]");
      const section = document.querySelector<HTMLElement>("#case-study");
      if (!track || !wrap || !section) return;
      const overflow = () => Math.max(0, track.scrollWidth - wrap.offsetWidth);
      if (overflow() <= 0) return;
      const tween = gsap.fromTo(
        track,
        { x: 0 },
        {
          x: () => -overflow(),
          ease: "none",
          scrollTrigger: {
            trigger: section,
            start: "top top",
            end: () => "+=" + overflow(),
            pin: true,
            scrub: 1,
            anticipatePin: 1,
            invalidateOnRefresh: true,
          },
        },
      );
      return () => {
        tween.scrollTrigger?.kill();
        tween.kill();
        gsap.set(track, { clearProps: "transform" });
      };
    });
  }
</script>
