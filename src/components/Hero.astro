---
import { ui } from "../i18n";
import T from "./T.astro";
---
<section id="hero" class="relative min-h-screen flex items-end overflow-hidden bg-[#0a0a0a]">
  <!-- Background city photo (parallax). Replace /image/hero-city.jpg with the
       brand-approved shot when available. -->
  <div data-hero-bg class="absolute inset-0 z-0 will-change-transform">
    <img
      src="/image/hero-city.jpg"
      alt=""
      aria-hidden="true"
      class="w-full h-[115%] object-cover object-center"
    />
  </div>

  <!-- Darkening + warm-tint overlays -->
  <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-[#0a0a0a]/75 to-[#0a0a0a]/35 pointer-events-none"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-[#0a0a0a]/85 via-[#0a0a0a]/25 to-transparent pointer-events-none"></div>
  <div class="absolute -bottom-40 -left-40 w-[680px] h-[680px] bg-primary/15 blur-[140px] rounded-full pointer-events-none"></div>

  <div class="relative z-10 w-full max-w-[1280px] mx-auto px-6 pt-32 pb-16 md:pb-24">
    <!-- Badge -->
    <span data-hero-el class="inline-flex items-center gap-2 pl-1.5 pr-4 py-1.5 rounded-full text-white text-sm font-semibold shadow-md shadow-black/30 border border-white/10" style="background-image:linear-gradient(to left,#620000 0%,#EFB74F 40%)">
      <span class="w-6 h-6 rounded-full bg-gradient-to-br from-[#F8DD93] to-[#E0A93C] flex items-center justify-center text-[#5a0f0f] shrink-0">
        <span class="text-[13px] font-bold leading-none">$</span>
      </span>
      <T t={ui.hero.badge} />
    </span>

    <div class="mt-6 grid lg:grid-cols-12 gap-8 lg:gap-12 items-end">
      <!-- Headline -->
      <h1 class="lg:col-span-7 font-serif text-white font-medium tracking-tight text-[2.3rem] leading-[1.07] sm:text-5xl lg:text-[54px] lg:leading-[1.08]">
        <span data-l="id">
          <span class="block overflow-hidden"><span data-hero-line class="block">{ui.hero.line1.id}</span></span>
          <span class="block overflow-hidden"><span data-hero-line class="block">{ui.hero.line2.id}</span></span>
        </span>
        <span data-l="en">
          <span class="block overflow-hidden"><span data-hero-line class="block">{ui.hero.line1.en}</span></span>
          <span class="block overflow-hidden"><span data-hero-line class="block">{ui.hero.line2.en}</span></span>
        </span>
      </h1>

      <!-- Right column: paragraph + powered by -->
      <div class="lg:col-span-5 lg:pb-2">
        <p data-hero-el class="text-gray-300 text-base sm:text-lg leading-relaxed max-w-md">
          <T t={ui.hero.paragraph} />
        </p>
        <div data-hero-el class="mt-6 flex items-center gap-3">
          <span class="text-gray-400 text-sm"><T t={ui.poweredBy} /></span>
          <!-- TODO: swap for official BNI logo asset when provided -->
          <span class="inline-flex items-center gap-1.5">
            <span class="px-1.5 py-0.5 rounded bg-[#F26522] text-white text-[11px] font-extrabold leading-none">46</span>
            <span class="text-white font-extrabold text-lg tracking-tight">BNI</span>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduced) {
    const tl = gsap.timeline({ defaults: { ease: "power3.out" } });
    tl.from("[data-hero-line]", { yPercent: 115, duration: 0.9, stagger: 0.12 }, 0.15)
      .from("[data-hero-el]", { y: 22, opacity: 0, duration: 0.7, stagger: 0.15 }, 0.3);

    // Background parallax on scroll
    gsap.to("[data-hero-bg] img", {
      yPercent: 12,
      ease: "none",
      scrollTrigger: { trigger: "#hero", start: "top top", end: "bottom top", scrub: true },
    });
  }
</script>
