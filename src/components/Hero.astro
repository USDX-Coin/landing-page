---
import { APP_URL } from "../data/navigation";
import { ui } from "../i18n";
import T from "./T.astro";
import HeroGlobe from "./HeroGlobe.tsx";
---
<section id="hero" class="relative overflow-hidden bg-white pt-28 pb-20 md:pt-32 md:pb-28 lg:min-h-screen lg:flex lg:items-center">
  <!-- Dot grid pattern -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle, #1eaed5 1px, transparent 1px); background-size: 24px 24px;"></div>
  <!-- Gradient glows (parallax) -->
  <div data-hero-blob class="absolute -top-32 -right-24 w-[520px] h-[520px] bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>
  <div data-hero-blob class="absolute bottom-0 -left-24 w-[360px] h-[360px] bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-[1200px] mx-auto px-6 grid lg:grid-cols-2 gap-12 lg:gap-8 items-center relative z-10 w-full">
    <!-- Left: copy -->
    <div class="text-center lg:text-left">
      <span data-hero-el class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary-light text-primary text-xs font-semibold tracking-wide uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
        <T t={ui.hero.badge} />
      </span>

      <h1 class="mt-6 text-[2rem] leading-[1.1] sm:text-5xl lg:text-[56px] font-bold lg:leading-[1.08] tracking-tight text-dark">
        <span data-l="id">
          <span data-hero-line class="block">{ui.hero.line1.id}</span>
          <span data-hero-line class="block">{ui.hero.line2.id}</span>
          <span data-hero-line class="block text-primary">{ui.hero.line3.id}</span>
        </span>
        <span data-l="en">
          <span data-hero-line class="block">{ui.hero.line1.en}</span>
          <span data-hero-line class="block">{ui.hero.line2.en}</span>
          <span data-hero-line class="block text-primary">{ui.hero.line3.en}</span>
        </span>
      </h1>

      <p data-hero-el class="mt-6 text-gray-600 text-base sm:text-lg leading-relaxed max-w-xl mx-auto lg:mx-0">
        <T t={ui.hero.paragraph} />
      </p>

      <div data-hero-el class="mt-8 flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start">
        <a
          href={APP_URL}
          data-app-link
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 bg-primary text-white font-semibold rounded-xl hover:bg-primary-dark hover:shadow-xl hover:shadow-primary/25 hover:-translate-y-0.5 transition-all duration-300 no-underline text-base"
        >
          <T t={ui.cta} />
        </a>
        <a
          href="#features"
          class="group inline-flex items-center gap-2 px-6 py-3.5 text-dark font-semibold hover:text-primary transition-colors duration-300 no-underline text-base"
        >
          <T t={ui.hero.explore} />
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Trust stats -->
      <div data-hero-el class="mt-12 grid grid-cols-3 gap-4 sm:gap-6 max-w-md mx-auto lg:mx-0">
        <div class="text-center lg:text-left">
          <div class="text-xl sm:text-2xl font-bold text-dark">1:1</div>
          <div class="text-xs text-gray-500 mt-1"><T t={ui.hero.stat1} /></div>
        </div>
        <div class="text-center lg:text-left border-x border-gray-100 px-2 sm:px-4">
          <div class="text-xl sm:text-2xl font-bold text-dark">8</div>
          <div class="text-xs text-gray-500 mt-1"><T t={ui.hero.stat2} /></div>
        </div>
        <div class="text-center lg:text-left">
          <div class="text-xl sm:text-2xl font-bold text-dark">24/7</div>
          <div class="text-xs text-gray-500 mt-1"><T t={ui.hero.stat3} /></div>
        </div>
      </div>
    </div>

    <!-- Right: cobe globe — USDX value flowing to emerging markets (light, self-contained) -->
    <div class="flex items-center justify-center">
      <div data-hero-stage class="relative w-full max-w-[520px] aspect-square">
        <!-- soft ambient blue glow behind the globe -->
        <div class="absolute inset-0 -z-10 pointer-events-none" style="background: radial-gradient(circle at 50% 47%, rgba(30,174,213,0.12), transparent 62%);"></div>
        <!-- soft contact shadow under the globe (COBE-style depth) -->
        <div class="absolute left-1/2 bottom-[6%] -translate-x-1/2 w-3/5 h-8 bg-dark/10 blur-2xl rounded-[50%] pointer-events-none"></div>

        <!-- WebGL canvas mounts here -->
        <HeroGlobe client:load />

        <!-- subtle caption -->
        <div class="absolute -bottom-2 left-0 right-0 text-center text-[11px] uppercase tracking-[0.22em] text-gray-400 pointer-events-none">
          <T t={ui.hero.globeCaption} />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduced) {
    const ease = "power3.out";

    const tl = gsap.timeline({ defaults: { ease } });
    tl.from("[data-hero-el]", { y: 24, opacity: 0, duration: 0.7, stagger: 0.12 }, 0.1)
      .from("[data-hero-line]", { yPercent: 110, opacity: 0, duration: 0.8, stagger: 0.1 }, 0)
      .from("[data-hero-stage]", { opacity: 0, scale: 0.94, duration: 1 }, 0.25);

    // Scroll parallax
    gsap.to("[data-hero-stage]", {
      yPercent: 6,
      ease: "none",
      scrollTrigger: { trigger: "#hero", start: "top top", end: "bottom top", scrub: true },
    });
    gsap.to("[data-hero-blob]", {
      yPercent: -30,
      ease: "none",
      scrollTrigger: { trigger: "#hero", start: "top top", end: "bottom top", scrub: true },
    });
  }
</script>
