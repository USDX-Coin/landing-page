---
import { ui } from "../i18n";
import T from "./T.astro";

// Honest, structural figures (no fabricated volumes). Swap with real metrics
// when available. `count` drives the scroll count-up; static values render as-is.
const stats = [
  { value: "100", suffix: "%", count: 100, label: ui.stats.s1Label },
  { value: "8", suffix: "", count: 8, label: ui.stats.s2Label },
  { value: "<$0.01", suffix: "", count: null, label: ui.stats.s3Label },
  { value: "365", suffix: "", count: 365, label: ui.stats.s4Label },
];
---
<section id="stats" class="relative bg-white py-20 md:py-28">
  <div class="max-w-[1200px] mx-auto px-6">
    <!-- Heading -->
    <div data-stats-head class="max-w-2xl mx-auto text-center mb-12 md:mb-16">
      <div class="flex items-center justify-center gap-3 mb-4">
        <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
        <span class="text-primary font-semibold text-sm uppercase tracking-widest"><T t={ui.stats.eyebrow} /></span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-[44px] font-bold text-dark leading-[1.1] tracking-tight">
        <T t={ui.stats.heading} />
      </h2>
      <p class="mt-4 text-gray-600 text-base sm:text-lg leading-relaxed">
        <T t={ui.stats.sub} />
      </p>
    </div>

    <!-- Stat panel -->
    <div class="rounded-3xl border border-gray-100 bg-gradient-to-br from-primary/[0.06] via-primary/[0.03] to-transparent overflow-hidden">
      <div class="grid grid-cols-2 lg:grid-cols-4 divide-y divide-x divide-gray-100 lg:divide-y-0">
        {stats.map((s) => (
          <div data-stat-item class="p-8 sm:p-10 text-center lg:text-left">
            <div class="text-4xl sm:text-5xl lg:text-[56px] font-bold text-dark tracking-tight leading-none tabular-nums">
              <span
                data-stat-value
                data-count={s.count ?? ""}
                data-suffix={s.suffix}
              >{s.value}{s.suffix}</span>
            </div>
            <div class="mt-3 text-sm text-gray-500 leading-snug"><T t={s.label} /></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduced) {
    gsap.from("[data-stats-head]", {
      y: 28, opacity: 0, duration: 0.8, ease: "power3.out",
      scrollTrigger: { trigger: "[data-stats-head]", start: "top 82%" },
    });

    gsap.from("[data-stat-item]", {
      y: 24, opacity: 0, duration: 0.7, stagger: 0.1, ease: "power3.out",
      scrollTrigger: { trigger: "#stats", start: "top 75%" },
    });

    // Count-up for numeric stats
    document.querySelectorAll<HTMLElement>("[data-stat-value]").forEach((el) => {
      const target = Number(el.dataset.count);
      if (!el.dataset.count || Number.isNaN(target)) return;
      const suffix = el.dataset.suffix || "";
      const counter = { val: 0 };
      ScrollTrigger.create({
        trigger: el,
        start: "top 85%",
        once: true,
        onEnter: () =>
          gsap.to(counter, {
            val: target,
            duration: 1.6,
            ease: "power2.out",
            onUpdate: () => {
              el.textContent = Math.round(counter.val).toLocaleString("en-US") + suffix;
            },
          }),
      });
    });
  }
</script>
