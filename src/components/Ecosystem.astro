---
import { chains, partners } from "../data/chains";

// Single ring: all chains evenly spaced, orbiting clockwise.
// Positions are percentages of the (square) stage, so they scale at any size.
const RADIUS = 0.42;
const pos = (angle: number, r: number) => {
  const rad = (angle * Math.PI) / 180;
  return { left: 50 + r * 100 * Math.cos(rad), top: 50 + r * 100 * Math.sin(rad) };
};
const ring = chains.map((chain, i) => ({ chain, ...pos((360 / chains.length) * i - 90, RADIUS) }));
---
<section id="ecosystem" class="relative bg-white py-16 md:py-20 px-6 overflow-hidden">
  <div class="max-w-[1200px] mx-auto relative">
    <div data-eco-head class="text-center relative z-10">
      <div class="flex justify-center mb-4">
        <span class="inline-flex items-center px-4 py-1.5 rounded-full border border-gray-200 bg-white shadow-sm text-primary text-xs font-semibold uppercase tracking-widest">
          Multi-Chain
        </span>
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-dark leading-tight tracking-tight max-w-2xl mx-auto">
        Live on the chains you already use
      </h2>
      <p class="mt-3 text-gray-600 text-sm sm:text-base max-w-lg mx-auto">
        USDX moves natively across 8 major blockchains — hover to explore each, click to dive in.
      </p>
    </div>

    <!-- Orbital stage -->
    <div data-eco-stage class="relative mx-auto mt-2 w-full max-w-[460px] aspect-square">
      <!-- center glow -->
      <div data-hub-glow class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[45%] h-[45%] bg-primary/15 blur-3xl rounded-full"></div>
      <!-- guide rings -->
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[84%] h-[84%] rounded-full border border-gray-100"></div>
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[56%] h-[56%] rounded-full border border-gray-100/70"></div>

      <!-- central USDX hub -->
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-20">
        <div data-hub-inner class="relative w-20 h-20 sm:w-24 sm:h-24 rounded-full shadow-xl shadow-primary/40 ring-4 ring-white">
          <img src="/image/Logo.svg" alt="USDX" class="w-full h-full rounded-full" />
        </div>
      </div>

      <!-- orbit ring -->
      <div data-orbit data-dir="1" data-dur="60" class="absolute inset-0">
        {ring.map(({ chain, left, top }) => (
          <a
            href={chain.url}
            target="_blank"
            rel="noopener noreferrer"
            title={chain.name}
            data-orbit-item
            class="group absolute z-10 no-underline"
            style={`left:${left}%; top:${top}%; transform: translate(-50%,-50%);`}
          >
            <div data-counter class="relative flex items-center justify-center">
              <div class="badge w-11 h-11 sm:w-14 sm:h-14 rounded-full bg-white border border-gray-100 shadow-md shadow-gray-200/60 flex items-center justify-center transition-all duration-300 group-hover:scale-125 group-hover:border-primary/30 group-hover:shadow-lg group-hover:shadow-primary/10">
                <img src={chain.icon} alt={chain.name} class="w-6 h-6 sm:w-8 sm:h-8" loading="lazy" />
              </div>
              <span class="pointer-events-none absolute left-1/2 -translate-x-1/2 -top-9 px-2.5 py-1 rounded-lg bg-dark text-white text-xs font-semibold whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-200 shadow-lg">
                {chain.name}
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Partners -->
  <div class="max-w-[1200px] mx-auto mt-16" data-eco-partners>
    <div class="flex justify-center mb-7">
      <span class="inline-flex items-center px-4 py-1.5 rounded-full border border-gray-200 bg-white shadow-sm text-primary text-xs font-semibold uppercase tracking-widest">
        Trusted Partners
      </span>
    </div>

    <div class="overflow-hidden relative">
      <div class="absolute left-0 top-0 bottom-0 w-16 bg-gradient-to-r from-white to-transparent z-10"></div>
      <div class="absolute right-0 top-0 bottom-0 w-16 bg-gradient-to-l from-white to-transparent z-10"></div>

      <div class="flex animate-marquee w-max will-change-transform">
        {[...partners, ...partners].map((partner) => (
          <a
            href={partner.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 px-6 py-4 mx-2 rounded-lg border border-gray-100 hover:border-primary/30 hover:shadow-sm transition-all no-underline min-w-[160px]"
          >
            <img src={partner.logo} alt={partner.name} class="w-7 h-7 object-contain flex-shrink-0" loading="lazy" />
            <span class="text-gray-600 font-semibold text-sm whitespace-nowrap">{partner.name}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduced) {
    gsap.from("[data-eco-head]", {
      y: 24, opacity: 0, duration: 0.7, ease: "power3.out",
      scrollTrigger: { trigger: "[data-eco-head]", start: "top 85%" },
    });
    gsap.from("[data-eco-partners]", {
      y: 24, opacity: 0, duration: 0.7, ease: "power3.out",
      scrollTrigger: { trigger: "[data-eco-partners]", start: "top 90%" },
    });

    // Scroll-driven scale: starts small + faint, grows over a long range with
    // smoothed scrub so the zoom-in really reads.
    gsap.fromTo(
      "[data-eco-stage]",
      { scale: 0.4, opacity: 0.2 },
      {
        scale: 1, opacity: 1, ease: "none",
        scrollTrigger: { trigger: "[data-eco-stage]", start: "top 92%", end: "center 52%", scrub: 1.6 },
      },
    );

    gsap.to("[data-hub-glow]", {
      scale: 1.2, opacity: 0.7, duration: 2.6, ease: "sine.inOut", repeat: -1, yoyo: true,
    });

    // Continuous clockwise orbit + upright counter-rotation
    const orbitTweens: gsap.core.Tween[] = [];
    gsap.utils.toArray<HTMLElement>("[data-orbit]").forEach((orbit) => {
      const dir = Number(orbit.dataset.dir);
      const dur = Number(orbit.dataset.dur);
      orbitTweens.push(gsap.to(orbit, { rotation: 360 * dir, duration: dur, ease: "none", repeat: -1 }));
      orbit.querySelectorAll<HTMLElement>("[data-counter]").forEach((c) => {
        orbitTweens.push(gsap.to(c, { rotation: -360 * dir, duration: dur, ease: "none", repeat: -1 }));
      });
    });

    // Pause the orbit while inspecting a chain (easier to hover/click)
    document.querySelectorAll<HTMLElement>("[data-orbit-item]").forEach((item) => {
      item.addEventListener("mouseenter", () => orbitTweens.forEach((t) => t.pause()));
      item.addEventListener("mouseleave", () => orbitTweens.forEach((t) => t.resume()));
    });
  }
</script>
