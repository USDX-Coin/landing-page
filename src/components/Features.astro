---
import { features } from "../data/features";
import { iconPaths } from "../data/icons";
import { chains } from "../data/chains";
import { ui } from "../i18n";
import T from "./T.astro";

// Chains evenly on a ring around the hub (multi-chain card).
const cluster = [
  { left: 50, top: 13 },
  { left: 80, top: 31 },
  { left: 80, top: 69 },
  { left: 50, top: 87 },
  { left: 20, top: 69 },
  { left: 20, top: 31 },
];
// Real avatar photos on the world map (global-access card).
const avatars = [
  { src: "/image/avatar-1.png", top: 12, left: 58 },
  { src: "/image/avatar-2.png", top: 52, left: 14 },
  { src: "/image/avatar-3.png", top: 58, left: 76 },
  { src: "/image/avatar-4.png", top: 30, left: 40 },
];
// Tick marks for the settlement speed gauge.
const gaugeTicks = Array.from({ length: 44 }, (_, i) => i);
---
<section id="features" class="relative mx-auto w-full max-w-[1376px] rounded-2xl overflow-hidden bg-[#0f0f0f]">
  <!-- red glow behind the heading (#B60000 ellipse) -->
  <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[1100px] h-[360px] bg-[#b60000]/35 blur-[130px] rounded-[50%] pointer-events-none"></div>
  <!-- faint grid pattern -->
  <div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 48px 48px;"></div>

  <div class="relative px-6 sm:px-10 lg:px-11 py-12 lg:py-[52px]">
    <!-- Heading (centered) -->
    <div data-feat-head class="text-center max-w-[600px] mx-auto flex flex-col items-center gap-4">
      <span class="inline-flex items-center gap-3 pl-2 pr-5 py-2 rounded-full text-white text-base font-medium font-tight" style="background-image:linear-gradient(90deg,rgba(239,183,79,0.4) 0%,rgba(98,0,0,0) 100%)">
        <span class="w-7 h-7 rounded-full bg-[#F7A100] flex items-center justify-center text-white shrink-0">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l1.7 6.7L20 10l-6.3 1.3L12 18l-1.7-6.7L4 10l6.3-1.3z"/></svg>
        </span>
        <T t={ui.features.eyebrow} />
      </span>
      <h2 class="font-serif font-medium text-4xl sm:text-5xl lg:text-[56px] lg:leading-[60px] tracking-tight bg-[linear-gradient(180deg,#fff_0%,rgba(255,255,255,0.4)_100%)] bg-clip-text text-transparent">
        <span class="block"><T t={ui.features.heading1} /></span>
        <span class="block"><T t={ui.features.heading2} /></span>
      </h2>
      <p class="text-zinc-400 text-base leading-[26px] max-w-[511px]">
        <T t={ui.features.sub} />
      </p>
    </div>

    <!-- 6-card grid -->
    <div class="mt-10 grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {features.map((feature, i) => (
        <article
          data-feat-card
          data-card={feature.icon}
          style={`--st:${88 + i * 14}px`}
          class="feat-card group relative rounded-2xl border border-white/[0.06] bg-[#141414] overflow-hidden transition-all duration-300 hover:border-white/15 lg:hover:-translate-y-1"
        >
          <!-- Visual panel -->
          <div class="relative h-60 overflow-hidden border-b border-white/[0.06] bg-[radial-gradient(circle_at_50%_0%,rgba(255,255,255,0.05),transparent_70%)]">
            <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 20px 20px;"></div>

            {feature.icon === "shield" && (
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="absolute inset-x-7 inset-y-6 rounded-2xl border border-white/[0.06]"></div>
                <svg class="absolute inset-0 w-full h-full" preserveAspectRatio="none" viewBox="0 0 100 100" fill="none" stroke="rgba(224,169,60,0.32)" stroke-width="0.7" stroke-linecap="round">
                  <path data-fx-line d="M50 32 V50 M20 50 H80 M20 50 V62 M50 50 V62 M80 50 V62" stroke-dasharray="220" />
                </svg>
                <div data-fx-shield class="absolute top-5 left-1/2 -translate-x-1/2 w-12 h-12 rounded-2xl bg-gold/15 border border-gold/30 flex items-center justify-center">
                  <svg class="w-6 h-6 text-gold-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={iconPaths.shield} /></svg>
                </div>
                <div data-fx-node class="absolute bottom-9 left-[18%] w-11 h-11 rounded-full bg-[#1c1c1c] border border-white/10 flex items-center justify-center text-gray-300">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={iconPaths.dollar} /></svg>
                </div>
                <div data-fx-node class="absolute bottom-9 left-1/2 -translate-x-1/2 w-11 h-11 rounded-full bg-[#1c1c1c] border border-white/10 flex items-center justify-center text-xs font-bold text-gold-light">1:1</div>
                <div data-fx-node class="absolute bottom-9 right-[18%] w-11 h-11 rounded-full bg-gold-dark/30 border border-gold/40 flex items-center justify-center">
                  <img src="/image/Logo.svg" alt="" class="w-7 h-7" />
                </div>
              </div>
            )}

            {feature.icon === "zap" && (
              <div class="absolute inset-0 flex items-center justify-center">
                <span data-fx-txn class="absolute top-7 left-6 text-[9px] text-gray-600">Transaction</span>
                <span data-fx-txn class="absolute top-7 right-6 text-[9px] text-gray-600">Transaction</span>
                <span data-fx-txn class="absolute bottom-8 left-8 text-[9px] text-gray-600">Transaction</span>
                <span data-fx-txn class="absolute bottom-8 right-8 text-[9px] text-gray-600">Transaction</span>
                <div class="relative w-28 h-28">
                  <svg class="w-full h-full" viewBox="0 0 100 100">
                    {gaugeTicks.map((t) => (
                      <line
                        data-tick
                        x1="50" y1="6" x2="50" y2="15"
                        stroke="#d4202e" stroke-width="2.4" stroke-linecap="round"
                        transform={`rotate(${t * (360 / 44)} 50 50)`}
                        style={`opacity:${Math.max(0.16, 0.9 - (t / 44) * 0.95).toFixed(2)}`}
                      />
                    ))}
                  </svg>
                  <div class="absolute inset-0 flex items-center justify-center">
                    <div class="w-16 h-16 rounded-full bg-[#141414] border border-white/10 flex flex-col items-center justify-center shadow-[0_0_24px_rgba(212,32,46,0.25)]">
                      <svg data-fx-bolt class="w-5 h-5 text-primary-light" fill="currentColor" viewBox="0 0 24 24"><path d={iconPaths.zap} /></svg>
                      <span class="text-sm font-bold text-white leading-none mt-0.5">0.1s</span>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {feature.icon === "dollar" && (
              <div class="absolute inset-0 p-4 flex flex-col justify-center gap-2">
                <div class="rounded-xl bg-[#1c1c1c] border border-white/10 px-3.5 py-2">
                  <div class="text-[9px] uppercase tracking-wider text-gray-500"><T t={ui.hero.totalBalance} /></div>
                  <div class="text-lg font-bold text-white leading-tight"><span data-fx-balance>240,000</span> <span class="text-gold-light text-sm">USDX</span></div>
                  <div class="text-[10px] text-gray-500">≈ $345,000</div>
                </div>
                <div data-fx-walletrow class="rounded-xl bg-[#1c1c1c] border border-white/10 px-3 py-2 flex items-center gap-2.5">
                  <div class="w-7 h-7 rounded-full bg-gold-dark/30 border border-gold/40 flex items-center justify-center shrink-0">
                    <img src="/image/Logo.svg" alt="" class="w-5 h-5" />
                  </div>
                  <div class="min-w-0">
                    <div class="text-[11px] font-semibold text-white leading-tight truncate"><T t={ui.features.walletCompany} /></div>
                    <div class="text-[9px] text-gray-500 leading-tight truncate"><T t={ui.features.walletNote} /></div>
                  </div>
                  <span data-fx-walletamt class="ml-auto text-[11px] font-semibold text-emerald-400 whitespace-nowrap">+240 USDX</span>
                </div>
                <div class="grid grid-cols-2 gap-2">
                  <div data-fx-action class="rounded-lg bg-[#1c1c1c] border border-white/10 py-1.5 flex flex-col items-center gap-0.5">
                    <svg class="w-4 h-4 text-gold-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14m0 0l-6-6m6 6l6-6" /></svg>
                    <span class="text-[9px] text-gray-300"><T t={ui.hero.actionReceive} /></span>
                  </div>
                  <div data-fx-action class="rounded-lg bg-[#1c1c1c] border border-white/10 py-1.5 flex flex-col items-center gap-0.5">
                    <svg class="w-4 h-4 text-gold-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4M16 17H4m0 0l4 4m-4-4l4-4" /></svg>
                    <span class="text-[9px] text-gray-300"><T t={ui.hero.actionSwap} /></span>
                  </div>
                </div>
              </div>
            )}

            {feature.icon === "layers" && (
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="absolute w-44 h-44 rounded-full border border-white/[0.06]"></div>
                <div class="absolute w-28 h-28 rounded-full border border-white/[0.06]"></div>
                <div data-fx-orbit class="absolute w-44 h-44">
                  {chains.slice(0, 6).map((chain, ci) => (
                    <div
                      data-fx-chain
                      class="absolute w-9 h-9 rounded-full bg-[#1c1c1c] border border-white/10 flex items-center justify-center"
                      style={`top:${cluster[ci].top}%; left:${cluster[ci].left}%; transform: translate(-50%,-50%);`}
                    >
                      <img src={chain.icon} alt={chain.name} class="w-5 h-5" loading="lazy" />
                    </div>
                  ))}
                </div>
                <div data-fx-hub class="relative w-14 h-14 rounded-full bg-gold-dark/25 border border-gold/40 flex items-center justify-center z-10">
                  <img src="/image/Logo.svg" alt="USDX" class="w-10 h-10" />
                </div>
              </div>
            )}

            {feature.icon === "check" && (
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="absolute bottom-0 inset-x-0 h-16 flex items-end justify-center gap-1.5 opacity-20">
                  {[10, 18, 14, 24, 16, 28, 12, 20].map((h) => (
                    <span data-fx-bar class="w-3 bg-white/40 origin-bottom" style={`height:${h * 2}px;`}></span>
                  ))}
                </div>
                <div data-fx-bank class="relative w-20 h-20 rounded-full bg-gold/10 border border-gold/30 flex items-center justify-center">
                  <svg class="w-9 h-9 text-gold-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M3 21h18M5 21V10l7-5 7 5v11M9 21v-6h6v6" /></svg>
                </div>
              </div>
            )}

            {feature.icon === "globe" && (
              <div class="absolute inset-0">
                <div class="absolute inset-0 opacity-[0.08]" style="background-image: radial-gradient(circle, #fff 1.2px, transparent 1.2px); background-size: 13px 13px; mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, #000 40%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, #000 40%, transparent 75%);"></div>
                {avatars.map((a) => (
                  <div
                    data-fx-avatar
                    class="absolute w-12 h-12 rounded-full overflow-hidden ring-2 ring-[#141414] shadow-lg shadow-black/40"
                    style={`top:${a.top}%; left:${a.left}%; transform: translate(-50%,-50%);`}
                  >
                    <img src={a.src} alt="" class="w-full h-full object-cover" loading="lazy" />
                  </div>
                ))}
              </div>
            )}
          </div>

          <!-- Text -->
          <div class="p-6 flex flex-col gap-2">
            <h3 class="text-xl font-medium text-white"><T t={feature.title} /></h3>
            <p class="text-zinc-400 leading-[26px] text-base"><T t={feature.description} /></p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Mobile: cards stack on top of each other on scroll (sticky pile) */
  @media (max-width: 767px) {
    .feat-card {
      position: sticky;
      top: var(--st, 88px);
      box-shadow: 0 -10px 34px rgba(0, 0, 0, 0.55);
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduced) {
    gsap.from("[data-feat-head]", {
      y: 28, opacity: 0, duration: 0.8, ease: "power3.out",
      scrollTrigger: { trigger: "[data-feat-head]", start: "top 82%", once: true },
    });

    // Reveal each card as it enters (per-card trigger, desktop only — on mobile
    // the sticky stack is the effect and a transform reveal fights `position:sticky`).
    const isDesktop = window.matchMedia("(min-width: 768px)").matches;
    if (isDesktop) {
      gsap.utils.toArray<HTMLElement>("[data-feat-card]").forEach((card) => {
        gsap.from(card, {
          y: 36, opacity: 0, duration: 0.7, ease: "power3.out",
          scrollTrigger: { trigger: card, start: "top 88%", once: true },
        });
      });
    }

    // Distinct, dramatic hover animation per card, matched to its content
    const qa = (el: Element, sel: string) => gsap.utils.toArray<HTMLElement>(el.querySelectorAll(sel));
    const q1 = (el: Element, sel: string) => el.querySelector(sel) as HTMLElement | null;

    gsap.utils.toArray<HTMLElement>("[data-feat-card]").forEach((card) => {
      const type = card.dataset.card;
      let busy = false;
      card.addEventListener("mouseenter", () => {
        if (busy) return;
        busy = true;
        setTimeout(() => (busy = false), 700);
        switch (type) {
          case "shield": // verify: the audit link draws, shield stamps, nodes lock in
            gsap.fromTo(q1(card, "[data-fx-line]"), { strokeDashoffset: 220 }, { strokeDashoffset: 0, duration: 0.7, ease: "power2.out" });
            gsap.fromTo(q1(card, "[data-fx-shield]"), { scale: 1 }, { scale: 1.2, duration: 0.28, yoyo: true, repeat: 1, ease: "power2.out", transformOrigin: "50% 50%" });
            gsap.fromTo(qa(card, "[data-fx-node]"), { scale: 0.4, opacity: 0.4 }, { scale: 1, opacity: 1, duration: 0.55, stagger: 0.1, ease: "back.out(2.6)" });
            break;
          case "zap": // a pulse of light sweeps the speed dial + the bolt sparks
            gsap.fromTo(qa(card, "[data-tick]"), { opacity: 0.12 }, { opacity: 1, duration: 0.22, stagger: { each: 0.012 }, yoyo: true, repeat: 1, ease: "sine.inOut" });
            gsap.fromTo(q1(card, "[data-fx-bolt]"), { scale: 0.5, opacity: 0.3 }, { scale: 1.15, opacity: 1, duration: 0.35, yoyo: true, repeat: 1, ease: "back.out(3)", transformOrigin: "50% 50%" });
            gsap.fromTo(qa(card, "[data-fx-txn]"), { opacity: 0.25 }, { opacity: 0.9, duration: 0.3, stagger: 0.05, yoyo: true, repeat: 1 });
            break;
          case "dollar": { // a payment lands: balance counts up, row slides in, actions rise
            const bal = q1(card, "[data-fx-balance]");
            if (bal) {
              const o = { v: 0 };
              gsap.to(o, { v: 240000, duration: 0.9, ease: "power1.out", onUpdate: () => { bal.textContent = Math.round(o.v).toLocaleString("en-US"); } });
            }
            gsap.fromTo(q1(card, "[data-fx-walletrow]"), { x: 28, opacity: 0 }, { x: 0, opacity: 1, duration: 0.5, ease: "power3.out" });
            gsap.fromTo(q1(card, "[data-fx-walletamt]"), { scale: 1 }, { scale: 1.25, duration: 0.3, yoyo: true, repeat: 1, ease: "power2.out", transformOrigin: "100% 50%" });
            gsap.fromTo(qa(card, "[data-fx-action]"), { y: 14, opacity: 0 }, { y: 0, opacity: 1, duration: 0.45, stagger: 0.1, ease: "back.out(2)" });
            break;
          }
          case "layers": // the constellation snaps in and rotates into place around the hub
            gsap.fromTo(q1(card, "[data-fx-orbit]"), { rotation: -28, scale: 0.85 }, { rotation: 0, scale: 1, duration: 1.1, ease: "power3.out", transformOrigin: "50% 50%" });
            gsap.fromTo(qa(card, "[data-fx-chain]"), { scale: 0.3, opacity: 0.3 }, { scale: 1, opacity: 1, duration: 0.55, stagger: 0.07, ease: "back.out(2.4)" });
            gsap.fromTo(q1(card, "[data-fx-hub]"), { scale: 1 }, { scale: 1.18, duration: 0.3, yoyo: true, repeat: 1, ease: "power2.out", transformOrigin: "50% 50%" });
            break;
          case "check": // the skyline rises like a chart, the institution gets stamped
            gsap.fromTo(qa(card, "[data-fx-bar]"), { scaleY: 0.12 }, { scaleY: 1, duration: 0.55, stagger: 0.05, ease: "power2.out" });
            gsap.fromTo(q1(card, "[data-fx-bank]"), { scale: 0.82 }, { scale: 1, duration: 0.5, ease: "back.out(2.6)", transformOrigin: "50% 50%" });
            break;
          case "globe": // people pop onto the map worldwide, one after another
            gsap.fromTo(qa(card, "[data-fx-avatar]"), { scale: 0.3, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.55, stagger: 0.1, ease: "back.out(2.6)" });
            break;
        }
      });
    });
  }
</script>
