---
import { features } from "../data/features";
import { iconPaths } from "../data/icons";
import { chains } from "../data/chains";
import { ui } from "../i18n";
import T from "./T.astro";
---
<!-- Heading + horizontal scroll track (pinned & vertically centered on desktop) -->
<section id="features" data-feat-pin class="relative bg-white pt-24 md:pt-28 pb-20 md:pb-28 lg:py-0 lg:h-screen lg:flex lg:flex-col lg:justify-center overflow-hidden">
  <!-- Section heading (left-aligned) -->
  <div data-feat-head class="max-w-[1200px] mx-auto w-full px-6 mb-6 lg:mb-8">
    <div class="max-w-2xl">
      <div data-fade class="flex items-center gap-3 mb-4">
        <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
        <span class="text-primary font-semibold text-sm uppercase tracking-widest"><T t={ui.features.eyebrow} /></span>
      </div>
      <h2 data-reveal class="text-3xl sm:text-4xl lg:text-[44px] font-bold text-dark leading-[1.1] tracking-tight">
        <T t={ui.features.heading} />
      </h2>
      <p data-fade class="mt-4 text-gray-600 text-base sm:text-lg leading-relaxed">
        <T t={ui.features.sub} />
      </p>
      <p data-fade class="mt-3 text-sm text-gray-400 hidden lg:flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        <T t={ui.features.scroll} />
      </p>
    </div>
  </div>

  <div data-track-wrap class="w-full overflow-x-auto lg:overflow-visible snap-x snap-mandatory lg:snap-none scrollbar-hide">
    <div data-track class="flex gap-5 sm:gap-6 px-6 lg:px-12 py-6">
      {features.map((feature, i) => (
        <article
          data-feat-card
          class="feature-card group relative shrink-0 w-[280px] sm:w-[340px] xl:w-[400px] 2xl:w-[460px] snap-center rounded-3xl border border-gray-100 bg-white overflow-hidden transition-all duration-300 hover:-translate-y-1.5 hover:border-primary/30 hover:shadow-2xl hover:shadow-primary/10"
        >
          <!-- Visual panel -->
          <div class="relative h-44 sm:h-48 overflow-hidden bg-gradient-to-br from-primary/10 via-primary/5 to-transparent">
            <div class="absolute inset-0 opacity-[0.05]" style="background-image: radial-gradient(circle, #1eaed5 1px, transparent 1px); background-size: 18px 18px;"></div>
            {feature.icon === "layers" ? (
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="relative w-40 h-28">
                  {chains.slice(0, 6).map((chain, ci) => (
                    <img
                      src={chain.icon}
                      alt={chain.name}
                      class="absolute w-10 h-10 rounded-full bg-white shadow-md ring-1 ring-gray-100 p-1.5"
                      style={`top:${[8, 0, 60, 70, 30, 50][ci]}px; left:${[10, 70, 0, 95, 50, 130][ci]}px;`}
                    />
                  ))}
                </div>
              </div>
            ) : (
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="w-20 h-20 rounded-3xl bg-white shadow-xl shadow-primary/10 flex items-center justify-center ring-1 ring-gray-100 transition-transform duration-500 group-hover:scale-110 group-hover:-rotate-6">
                  <svg class="w-10 h-10 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={iconPaths[feature.icon]} />
                  </svg>
                </div>
                <div class="absolute top-6 right-7 w-3 h-3 rounded-full bg-primary/30"></div>
                <div class="absolute bottom-8 left-8 w-2 h-2 rounded-full bg-primary/40"></div>
                <div class="absolute bottom-10 right-10 w-1.5 h-1.5 rounded-full bg-primary/20"></div>
              </div>
            )}
          </div>

          <!-- Text -->
          <div class="p-6 sm:p-7">
            <span class="text-xs font-semibold text-primary/60 tracking-widest">0{i + 1}</span>
            <h3 class="mt-2 text-lg font-semibold text-dark mb-2.5">
              <span data-l="id">
                <span class="text-primary">{feature.title.id.split(" ")[0]}</span>{" "}
                {feature.title.id.split(" ").slice(1).join(" ")}
              </span>
              <span data-l="en">
                <span class="text-primary">{feature.title.en.split(" ")[0]}</span>{" "}
                {feature.title.en.split(" ").slice(1).join(" ")}
              </span>
            </h3>
            <p class="text-gray-600 leading-relaxed text-sm"><T t={feature.description} /></p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  .scrollbar-hide::-webkit-scrollbar { display: none; }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!reduced) {
    // Heading + eyebrow + sub reveal handled globally via [data-reveal]/[data-fade].

    // Horizontal pinned scroll (desktop only). Mobile uses native swipe.
    const mm = gsap.matchMedia();
    mm.add("(min-width: 1024px)", () => {
      const track = document.querySelector<HTMLElement>("[data-track]");
      const pin = document.querySelector<HTMLElement>("[data-feat-pin]");
      if (!track || !pin) return;

      const overflow = () => track.scrollWidth - window.innerWidth;
      // Only bail if there is genuinely nothing to scroll (cards already fit).
      if (overflow() <= 0) return;
      const amount = () => overflow() + 48;

      const tween = gsap.to(track, {
        x: () => -amount(),
        ease: "none",
        scrollTrigger: {
          trigger: pin,
          start: "top top",
          // Compress the pin: cards travel their full width over a shorter
          // vertical scroll, so the "travel room" stays small even on big screens.
          end: () => "+=" + amount() * 0.6,
          pin: true,
          scrub: 1,
          anticipatePin: 1,
          invalidateOnRefresh: true,
        },
      });

      return () => {
        tween.scrollTrigger?.kill();
        tween.kill();
        gsap.set(track, { clearProps: "transform" });
      };
    });
  }
</script>
