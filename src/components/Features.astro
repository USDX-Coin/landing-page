---
import { features } from "../data/features";
import { iconPaths } from "../data/icons";
import { chains } from "../data/chains";
import { AUDIT_REPORT_URL } from "../data/audit";
import { ui } from "../i18n";
import T from "./T.astro";

// Chains evenly on a ring around the hub (multi-chain card).
const cluster = [
  { left: 50, top: 13 },
  { left: 80, top: 31 },
  { left: 80, top: 69 },
  { left: 50, top: 87 },
  { left: 20, top: 69 },
  { left: 20, top: 31 },
];
// Real avatar photos on the world map (global-access card), each tagged with a
// city to underline worldwide reach.
const avatars = [
  { src: "/image/avatar-1.png", top: 12, left: 58, city: "London" },
  { src: "/image/avatar-2.png", top: 52, left: 14, city: "New York" },
  { src: "/image/avatar-3.png", top: 58, left: 76, city: "Tokyo" },
  { src: "/image/avatar-4.png", top: 30, left: 40, city: "Jakarta" },
];
// Tick marks for the settlement speed gauge.
const gaugeTicks = Array.from({ length: 44 }, (_, i) => i);
---
<section id="features" class="relative mx-auto w-full max-w-[1376px] mb-4 rounded-2xl overflow-hidden bg-[#0f0f0f]">
  <!-- red glow behind the heading (#B60000 ellipse) -->
  <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[1100px] h-[360px] bg-[#b60000]/35 blur-[130px] rounded-[50%] pointer-events-none"></div>
  <!-- faint grid pattern — bottom area only (per Figma) -->
  <div class="absolute inset-x-0 bottom-0 h-2/3 opacity-[0.05]" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 48px 48px; mask-image: linear-gradient(to bottom, transparent, #000 45%); -webkit-mask-image: linear-gradient(to bottom, transparent, #000 45%);"></div>

  <div class="relative px-6 sm:px-10 lg:px-11 py-12 lg:py-[52px]">
    <!-- Heading (centered) -->
    <div data-feat-head class="text-center max-w-[600px] mx-auto flex flex-col items-center gap-4">
      <span class="inline-flex items-center gap-3 pl-2 pr-5 py-2 rounded-full text-white text-base font-medium font-tight" style="background-image:linear-gradient(90deg,rgba(239,183,79,0.4) 0%,rgba(98,0,0,0) 100%)">
        <span class="w-7 h-7 rounded-full bg-[#F7A100] flex items-center justify-center text-[#7a0a0a] shrink-0">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 4v16M5.07 8l13.86 8M18.93 8L5.07 16"/></svg>
        </span>
        <T t={ui.features.eyebrow} />
      </span>
      <h2 class="font-serif font-medium text-[32px] leading-[36px] sm:text-5xl sm:leading-tight lg:text-[56px] lg:leading-[60px] tracking-tight bg-[linear-gradient(180deg,#fff_0%,rgba(255,255,255,0.4)_100%)] bg-clip-text text-transparent">
        <span class="block"><T t={ui.features.heading1} /></span>
        <span class="block"><T t={ui.features.heading2} /></span>
      </h2>
      <p class="text-zinc-400 text-base leading-[26px] max-w-[511px]">
        <T t={ui.features.sub} />
      </p>
    </div>

    <!-- 6-card grid -->
    <div class="mt-10 grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {features.map((feature, i) => (
        <article
          data-feat-card
          data-card={feature.icon}
          style={`--st:${88 + i * 14}px`}
          class="feat-card group relative rounded-2xl border border-white/[0.06] bg-[#141414] overflow-hidden transition-all duration-300 hover:border-white/15 lg:hover:-translate-y-1"
        >
          <!-- Visual panel -->
          <div class="relative h-60 overflow-hidden border-b border-white/[0.06] bg-[radial-gradient(circle_at_50%_0%,rgba(255,255,255,0.05),transparent_70%)]">
            <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 20px 20px;"></div>

            {feature.icon === "shield" && (
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="absolute inset-x-7 inset-y-6 rounded-2xl border border-white/[0.06]"></div>
                <!-- audit wiring: a verification pulse flows from the shield down to
                     each node; nodes light up as it arrives -->
                <svg class="absolute inset-0 w-full h-full" viewBox="0 0 418 240" preserveAspectRatio="none" fill="none">
                  <!-- dim base wiring: guard fans out to $ (left) and the coin (right) only -->
                  <path d="M209 70 V100 M97 100 H321 M97 100 V158 M321 100 V158" stroke="rgba(224,169,60,0.18)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  <!-- bright energy pulses (drawn while active): trunk, left, right -->
                  <path data-fx-wire d="M209 70 V100" pathLength="1" stroke="#F7A100" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="stroke-dasharray:1;stroke-dashoffset:1;opacity:0" />
                  <path data-fx-wire d="M209 100 H97 V158" pathLength="1" stroke="#F7A100" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="stroke-dasharray:1;stroke-dashoffset:1;opacity:0" />
                  <path data-fx-wire d="M209 100 H321 V158" pathLength="1" stroke="#F7A100" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="stroke-dasharray:1;stroke-dashoffset:1;opacity:0" />
                </svg>
                <div data-fx-shield class="absolute top-4 left-1/2 -translate-x-1/2 w-14 h-14 rounded-full bg-[#1c1c1c] border border-white/10 flex items-center justify-center">
                  <svg class="w-6 h-6 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={iconPaths.shield} /></svg>
                </div>
                <div data-fx-node class="absolute bottom-9 left-[18%] w-11 h-11 rounded-full bg-[#1c1c1c] border border-white/10 flex items-center justify-center text-gray-300">
                  <span data-fx-ping class="absolute -inset-px rounded-full ring-2 ring-gold/70 opacity-0"></span>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={iconPaths.dollar} /></svg>
                </div>
                <div class="absolute bottom-9 left-1/2 -translate-x-1/2 w-11 h-11 rounded-full bg-[#1c1c1c] border border-white/10 flex items-center justify-center text-xs font-bold text-gold-light">1:1</div>
                <div data-fx-node class="absolute bottom-9 right-[18%] w-11 h-11">
                  <span data-fx-ping class="absolute -inset-px rounded-full ring-2 ring-gold/70 opacity-0"></span>
                  <img src="/image/logo-coin.png" alt="" class="w-full h-full" />
                </div>
              </div>
            )}

            {feature.icon === "zap" && (
              <div class="absolute inset-0 flex items-center justify-center">
                <span data-fx-txn class="absolute top-6 left-5 px-2 py-0.5 rounded-full border border-white/10 bg-white/[0.03] text-[9px] text-gray-400">Transaction</span>
                <span data-fx-txn class="absolute top-6 right-5 px-2 py-0.5 rounded-full border border-white/10 bg-white/[0.03] text-[9px] text-gray-400">Transaction</span>
                <span data-fx-txn class="absolute top-1/2 -translate-y-1/2 left-3 px-2 py-0.5 rounded-full border border-white/10 bg-white/[0.03] text-[9px] text-gray-400">Transaction</span>
                <span data-fx-txn class="absolute top-1/2 -translate-y-1/2 right-3 px-2 py-0.5 rounded-full border border-white/10 bg-white/[0.03] text-[9px] text-gray-400">Transaction</span>
                <span data-fx-txn class="absolute bottom-7 left-7 px-2 py-0.5 rounded-full border border-white/10 bg-white/[0.03] text-[9px] text-gray-400">Transaction</span>
                <span data-fx-txn class="absolute bottom-7 right-7 px-2 py-0.5 rounded-full border border-white/10 bg-white/[0.03] text-[9px] text-gray-400">Transaction</span>
                <div class="relative w-28 h-28">
                  <svg class="w-full h-full" viewBox="0 0 100 100">
                    {gaugeTicks.map((t) => (
                      <line
                        data-tick
                        x1="50" y1="6" x2="50" y2="15"
                        stroke="#d4202e" stroke-width="2.4" stroke-linecap="round"
                        transform={`rotate(${t * (360 / 44)} 50 50)`}
                        style={`opacity:${Math.max(0.16, 0.9 - (t / 44) * 0.95).toFixed(2)}`}
                      />
                    ))}
                  </svg>
                  <!-- glow dot scanning around the dial -->
                  <div data-fx-gspin class="absolute inset-0">
                    <span class="absolute left-1/2 top-1 -translate-x-1/2 w-2 h-2 rounded-full bg-[#ff5a4d] shadow-[0_0_10px_3px_rgba(255,80,60,0.7)]"></span>
                  </div>
                  <div class="absolute inset-0 flex items-center justify-center">
                    <div class="w-16 h-16 rounded-full bg-[#141414] border border-white/10 flex flex-col items-center justify-center shadow-[0_0_24px_rgba(212,32,46,0.25)]">
                      <svg data-fx-bolt class="w-5 h-5 text-primary-light" fill="currentColor" viewBox="0 0 24 24"><path d={iconPaths.zap} /></svg>
                      <span class="text-sm font-bold text-white leading-none mt-0.5">0.1s</span>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {feature.icon === "dollar" && (
              <div class="absolute inset-0 p-4 flex flex-col justify-center gap-2">
                <div class="rounded-xl bg-[#1c1c1c] border border-white/10 px-3.5 py-2">
                  <div class="text-[10px] text-gray-500"><T t={ui.hero.totalBalance} /></div>
                  <div class="text-lg font-bold text-white leading-tight"><span data-fx-balance>240,000</span> <span class="text-gold-light text-sm">USDX</span></div>
                  <div class="text-[10px] text-gray-500">≈ $240,000</div>
                </div>
                <div data-fx-walletrow class="rounded-xl bg-[#1c1c1c] border border-white/10 px-3 py-2 flex items-center gap-2.5">
                  <div class="w-7 h-7 shrink-0">
                    <img src="/image/logo-coin.png" alt="" class="w-full h-full" />
                  </div>
                  <div class="min-w-0">
                    <div class="text-[11px] font-semibold text-white leading-tight truncate"><T t={ui.features.walletCompany} /></div>
                    <div class="text-[9px] text-gray-500 leading-tight truncate"><T t={ui.features.walletNote} /></div>
                  </div>
                  <span data-fx-walletamt class="ml-auto text-[11px] font-semibold text-emerald-400 whitespace-nowrap">+240 USDX</span>
                </div>
                <div class="grid grid-cols-3 gap-2">
                  <div data-fx-action class="rounded-lg bg-[#1c1c1c] border border-white/10 py-1.5 flex flex-col items-center gap-0.5">
                    <svg class="w-4 h-4 text-gold-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19V5m0 0l-6 6m6-6l6 6" /></svg>
                    <span class="text-[9px] text-gray-300"><T t={ui.hero.actionSend} /></span>
                  </div>
                  <div data-fx-action class="rounded-lg bg-[#1c1c1c] border border-white/10 py-1.5 flex flex-col items-center gap-0.5">
                    <svg class="w-4 h-4 text-gold-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14m0 0l-6-6m6 6l6-6" /></svg>
                    <span class="text-[9px] text-gray-300"><T t={ui.hero.actionReceive} /></span>
                  </div>
                  <div data-fx-action class="rounded-lg bg-[#1c1c1c] border border-white/10 py-1.5 flex flex-col items-center gap-0.5">
                    <svg class="w-4 h-4 text-gold-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4M16 17H4m0 0l4 4m-4-4l4-4" /></svg>
                    <span class="text-[9px] text-gray-300"><T t={ui.hero.actionSwap} /></span>
                  </div>
                </div>
              </div>
            )}

            {feature.icon === "layers" && (
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="absolute w-44 h-44 rounded-full border border-white/[0.06]"></div>
                <div class="absolute w-28 h-28 rounded-full border border-white/[0.06]"></div>
                <!-- shockwave rings that ripple out from the hub -->
                <span data-fx-wave class="absolute w-16 h-16 rounded-full border-2 border-gold/50 opacity-0"></span>
                <span data-fx-wave class="absolute w-16 h-16 rounded-full border-2 border-gold/40 opacity-0"></span>
                <div data-fx-orbit class="absolute w-44 h-44">
                  {chains.slice(0, 6).map((chain, ci) => (
                    <div
                      data-fx-chain
                      class="absolute w-9 h-9 rounded-full bg-[#1c1c1c] border border-white/10 flex items-center justify-center"
                      style={`top:${cluster[ci].top}%; left:${cluster[ci].left}%; transform: translate(-50%,-50%);`}
                    >
                      <img src={chain.icon} alt={chain.name} class="w-5 h-5" loading="lazy" />
                    </div>
                  ))}
                </div>
                <div data-fx-hub class="relative w-14 h-14 z-10">
                  <img src="/image/logo-coin.png" alt="USDX" class="w-full h-full" />
                </div>
              </div>
            )}

            {feature.icon === "check" && (
              <div class="absolute inset-0 flex items-center justify-center">
                <!-- faint city skyline silhouette (buildings with windows) -->
                <div class="absolute bottom-0 inset-x-0 flex items-end justify-center gap-1.5">
                  {[[26, 90], [36, 130], [30, 70], [40, 150], [28, 100], [44, 120], [30, 60], [38, 140], [26, 84]].map(([w, h]) => (
                    <span data-fx-bar class="origin-bottom rounded-t-sm bg-white/[0.04]" style={`width:${w}px; height:${h}px; background-image: radial-gradient(circle, rgba(255,255,255,0.06) 1px, transparent 1px); background-size: 9px 11px;`}></span>
                  ))}
                </div>
                <!-- regulated institution in a large thin ring + rotating compliance scan -->
                <div data-fx-bank class="relative w-36 h-36 rounded-full border border-white/[0.12] flex items-center justify-center bg-[radial-gradient(circle,rgba(255,255,255,0.03),transparent_70%)]">
                  <!-- gold "compliance verified" ring that draws around the institution while active -->
                  <svg class="absolute inset-0 w-full h-full -rotate-90" viewBox="0 0 100 100" fill="none">
                    <circle data-fx-cring cx="50" cy="50" r="49" pathLength="1" stroke="#E0A93C" stroke-width="1.5" stroke-linecap="round" style="stroke-dasharray:1;stroke-dashoffset:1;opacity:0" />
                  </svg>
                  <svg class="relative w-12 h-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 21h18M3 10.5h18M3 7.5l9-5.25L21 7.5M4.5 10.5v10.5m4.5-10.5v10.5m6-10.5v10.5m4.5-10.5v10.5" />
                  </svg>
                </div>
              </div>
            )}

            {feature.icon === "globe" && (
              <div class="absolute inset-0">
                <img src="/image/eco-globe.png" alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-contain opacity-40" />
                <!-- great-circle style arcs between cities; a signal packet then
                     travels along each one (drawn fresh from 0 every loop) -->
                <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 100 100" preserveAspectRatio="none" fill="none" style="filter:drop-shadow(0 0 2.5px rgba(247,161,0,0.7))">
                  <path data-fx-link d="M14 52 Q22 36 40 30" pathLength="1" stroke="#FBD68A" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke" style="stroke-dasharray:1;stroke-dashoffset:1;opacity:0" />
                  <path data-fx-link d="M40 30 Q46 17 58 12" pathLength="1" stroke="#FBD68A" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke" style="stroke-dasharray:1;stroke-dashoffset:1;opacity:0" />
                  <path data-fx-link d="M40 30 Q60 36 76 58" pathLength="1" stroke="#FBD68A" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke" style="stroke-dasharray:1;stroke-dashoffset:1;opacity:0" />
                  <path data-fx-link d="M58 12 Q78 32 76 58" pathLength="1" stroke="#FBD68A" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke" style="stroke-dasharray:1;stroke-dashoffset:1;opacity:0" />
                  <!-- travelling signal packets (short bright dash that runs along each arc) -->
                  <path data-fx-spark d="M14 52 Q22 36 40 30" pathLength="1" stroke="#fff" stroke-width="2.6" stroke-linecap="round" vector-effect="non-scaling-stroke" style="stroke-dasharray:0.1 0.9;stroke-dashoffset:1;opacity:0" />
                  <path data-fx-spark d="M40 30 Q46 17 58 12" pathLength="1" stroke="#fff" stroke-width="2.6" stroke-linecap="round" vector-effect="non-scaling-stroke" style="stroke-dasharray:0.1 0.9;stroke-dashoffset:1;opacity:0" />
                  <path data-fx-spark d="M40 30 Q60 36 76 58" pathLength="1" stroke="#fff" stroke-width="2.6" stroke-linecap="round" vector-effect="non-scaling-stroke" style="stroke-dasharray:0.1 0.9;stroke-dashoffset:1;opacity:0" />
                  <path data-fx-spark d="M58 12 Q78 32 76 58" pathLength="1" stroke="#fff" stroke-width="2.6" stroke-linecap="round" vector-effect="non-scaling-stroke" style="stroke-dasharray:0.1 0.9;stroke-dashoffset:1;opacity:0" />
                </svg>
                {avatars.map((a) => (
                  <div class="absolute w-12 h-12" style={`top:${a.top}%; left:${a.left}%; transform: translate(-50%,-50%);`}>
                    <span data-fx-ping class="absolute inset-0 rounded-full ring-2 ring-white/40 opacity-0"></span>
                    <div data-fx-avatar class="relative w-full h-full rounded-full overflow-hidden ring-2 ring-[#141414] shadow-lg shadow-black/40">
                      <img src={a.src} alt="" class="w-full h-full object-cover" loading="lazy" />
                    </div>
                    <span class="absolute top-full left-1/2 -translate-x-1/2 mt-1 px-1.5 py-0.5 rounded-md bg-black/55 backdrop-blur-sm text-[8px] font-medium text-white/80 whitespace-nowrap leading-none">{a.city}</span>
                  </div>
                ))}
              </div>
            )}
          </div>

          <!-- Text -->
          <div class="p-6 flex flex-col gap-2">
            <h3 class="text-xl font-medium text-white"><T t={feature.title} /></h3>
            <p class="text-zinc-400 leading-[26px] text-base"><T t={feature.description} /></p>
            {feature.icon === "shield" && (
              <a
                href={AUDIT_REPORT_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-1 inline-flex items-center gap-1.5 w-fit text-gold-light hover:text-white text-sm font-medium no-underline transition-colors"
              >
                <T t={ui.features.auditCta} />
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7m0 0H8m9 0v9" /></svg>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Cursor-following spotlight + border glow (premium dark-card feel) */
  .feat-card::before,
  .feat-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .feat-card::before {
    z-index: 1;
    background: radial-gradient(280px circle at var(--mx, 50%) var(--my, 50%), rgba(212, 32, 46, 0.1), transparent 65%);
  }
  .feat-card::after {
    z-index: 2;
    padding: 1px;
    background: radial-gradient(280px circle at var(--mx, 50%) var(--my, 50%), rgba(255, 255, 255, 0.28), transparent 60%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
  }
  .feat-card:hover::before,
  .feat-card:hover::after {
    opacity: 1;
  }

  /* Mobile: cards stack on top of each other on scroll (sticky pile) */
  @media (max-width: 767px) {
    .feat-card {
      position: sticky;
      top: var(--st, 88px);
      box-shadow: 0 -10px 34px rgba(0, 0, 0, 0.55);
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Cursor-following spotlight: pipe pointer position into CSS vars per card
  gsap.utils.toArray<HTMLElement>("[data-feat-card]").forEach((card) => {
    card.addEventListener("pointermove", (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty("--mx", `${((e.clientX - r.left) / r.width) * 100}%`);
      card.style.setProperty("--my", `${((e.clientY - r.top) / r.height) * 100}%`);
    });
  });

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduced) {
    gsap.from("[data-feat-head]", {
      y: 28, opacity: 0, duration: 0.8, ease: "power3.out",
      scrollTrigger: { trigger: "[data-feat-head]", start: "top 82%", once: true },
    });

    // Reveal each card as it enters (per-card trigger, desktop only — on mobile
    // the sticky stack is the effect and a transform reveal fights `position:sticky`).
    const isDesktop = window.matchMedia("(min-width: 768px)").matches;
    if (isDesktop) {
      gsap.utils.toArray<HTMLElement>("[data-feat-card]").forEach((card) => {
        gsap.from(card, {
          y: 36, opacity: 0, duration: 0.7, ease: "power3.out",
          scrollTrigger: { trigger: card, start: "top 88%", once: true },
        });
      });
    }

    // Per-card content loop. By request: it only plays on HOVER on desktop
    // (hover-capable pointers) and only while the card is in view (focused) on
    // mobile/touch. Otherwise the illustration stays completely static.
    const qa = (el: Element, sel: string) => gsap.utils.toArray<HTMLElement>(el.querySelectorAll(sel));
    const q1 = (el: Element, sel: string) => el.querySelector(sel) as HTMLElement | null;

    const buildLoop = (card: HTMLElement, type?: string) => {
      const tl = gsap.timeline({ repeat: -1, paused: true });
      switch (type) {
        case "shield": { // a verification pulse flows shield -> trunk -> each node; nodes light up on arrival
          const shield = q1(card, "[data-fx-shield]");
          const wires = qa(card, "[data-fx-wire]");   // [trunk, $-branch, coin-branch]
          const nodes = qa(card, "[data-fx-node]");    // [$, coin] (1:1 is unconnected)
          const pings = qa(card, "[data-fx-ping]");
          const [trunk, ...branches] = wires;
          tl.set(wires, { strokeDashoffset: 1, opacity: 1 })
            // shield "scans"
            .to(shield, { scale: 1.08, duration: 0.35, yoyo: true, repeat: 1, ease: "power2.out", transformOrigin: "50% 50%" }, 0)
            // pulse races down the trunk, then flows straight on without a pause...
            .to(trunk, { strokeDashoffset: 0, duration: 0.4, ease: "power1.in" }, 0.1)
            // ...into BOTH branches at once (left $ + right coin together, no gap)
            .to(branches, { strokeDashoffset: 0, duration: 0.5, ease: "power1.out" }, 0.5)
            // both nodes light up together as the pulse lands
            .to(nodes, { scale: 1.18, duration: 0.24, yoyo: true, repeat: 1, ease: "power2.out", transformOrigin: "50% 50%" }, 0.95)
            .fromTo(pings, { scale: 0.8, opacity: 0.75 }, { scale: 1.6, opacity: 0, duration: 0.6, ease: "power1.out", transformOrigin: "50% 50%", immediateRender: false }, 0.95)
            // fade the wiring back out, then breathe before the next audit
            .to(wires, { opacity: 0, duration: 0.35 }, 1.25)
            .to({}, { duration: 0.7 });
          break;
        }
        case "zap": { // transactions light up in turn, the dial sweeps up to speed, then fires
          const txns = qa(card, "[data-fx-txn]");
          const ticks = qa(card, "[data-tick]");
          const bolt = q1(card, "[data-fx-bolt]");
          const spin = q1(card, "[data-fx-gspin]");
          // every tween returns to base, so the idle (static) state stays exactly as rendered
          tl.set(spin, { rotation: 0, transformOrigin: "50% 50%" })
            // transactions activate one after another (pulse, settle back)
            .to(txns, { scale: 1.14, color: "#f4f4f5", duration: 0.2, yoyo: true, repeat: 1, ease: "power2.out", stagger: 0.06, transformOrigin: "50% 50%" }, 0)
            // dial sweeps up to speed, fast then easing — reads as "instant"
            .to(spin, { rotation: 360, duration: 0.7, ease: "power3.out" }, 0.25)
            // a bright wave races around the gauge ring and fades back
            .to(ticks, { opacity: 1, duration: 0.16, yoyo: true, repeat: 1, ease: "sine.out", stagger: { each: 0.011, from: "start" } }, 0.3)
            // settled: the bolt fires
            .to(bolt, { scale: 1.35, duration: 0.16, yoyo: true, repeat: 1, ease: "power2.out", transformOrigin: "50% 50%" }, 0.95)
            .to({}, { duration: 0.7 }); // pause before the next batch
          break;
        }
        case "dollar": { // a payment lands: row flies in, balance ticks up +240, actions bounce
          const bal = q1(card, "[data-fx-balance]");
          const row = q1(card, "[data-fx-walletrow]");
          const amt = q1(card, "[data-fx-walletamt]");
          const actions = qa(card, "[data-fx-action]");
          const counter = { v: 240000 };
          tl.set(bal, { textContent: "240,000" })
            // the payment notification flies in from the right
            .fromTo(row, { x: 46, opacity: 0 }, { x: 0, opacity: 1, duration: 0.5, ease: "power3.out", immediateRender: false }, 0.05)
            .fromTo(amt, { scale: 0.4, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.4, ease: "back.out(3)", transformOrigin: "100% 50%", immediateRender: false }, 0.3)
            // the balance ticks up by the +240 that just arrived
            .fromTo(counter, { v: 239760 }, { v: 240000, duration: 0.9, ease: "power2.out", immediateRender: false, onUpdate: () => { if (bal) bal.textContent = Math.round(counter.v).toLocaleString("en-US"); } }, 0.3)
            .to(amt, { scale: 1.22, duration: 0.22, yoyo: true, repeat: 1, ease: "sine.inOut", transformOrigin: "100% 50%" }, 1.15)
            // the actions bounce up in sequence
            .to(actions, { y: -6, scale: 1.07, duration: 0.26, stagger: { each: 0.09, yoyo: true, repeat: 1 }, ease: "power2.out", transformOrigin: "50% 50%" }, 0.8)
            .to({}, { duration: 0.7 });
          break;
        }
        case "layers": { // the hub fires a shockwave that lights up each chain in turn
          const hub = q1(card, "[data-fx-hub]");
          const chainEls = qa(card, "[data-fx-chain]");
          const waves = qa(card, "[data-fx-wave]");
          tl.to(hub, { scale: 1.2, duration: 0.32, yoyo: true, repeat: 1, ease: "power2.out", transformOrigin: "50% 50%" }, 0);
          waves.forEach((w, i) => {
            tl.fromTo(w, { scale: 0.6, opacity: 0.7 }, { scale: 5.5, opacity: 0, duration: 1.1, ease: "power1.out", transformOrigin: "50% 50%", immediateRender: false }, 0.1 + i * 0.4);
          });
          tl.to(chainEls, { scale: 1.34, duration: 0.3, stagger: { each: 0.1, from: "start", yoyo: true, repeat: 1 }, ease: "back.out(3)", transformOrigin: "50% 50%" }, 0.35)
            .to({}, { duration: 0.7 });
          break;
        }
        case "check": { // the institution gets verified: a gold ring draws + the city powers on
          const bars = qa(card, "[data-fx-bar]");
          const bank = q1(card, "[data-fx-bank]");
          const ring = q1(card, "[data-fx-cring]");
          // .set at position 0 forces the ring back to EMPTY every loop, so it
          // always re-draws from 0 (like the zap dial), never picking up mid-way
          tl.set(ring, { strokeDashoffset: 1, opacity: 0.95 })
            .to(ring, { strokeDashoffset: 0, duration: 1.0, ease: "power1.inOut" }, 0)
            .to(bank, { scale: 1.07, duration: 0.4, yoyo: true, repeat: 1, ease: "sine.inOut", transformOrigin: "50% 50%" }, 0.15)
            .to(bars, { backgroundColor: "rgba(224,169,60,0.16)", scaleY: 1.2, duration: 0.35, stagger: { each: 0.07, from: "edges", yoyo: true, repeat: 1 }, ease: "power2.out" }, 0.2)
            .to(ring, { opacity: 0, duration: 0.35 }, 1.05)
            .to({}, { duration: 0.6 });
          break;
        }
        case "globe": { // a worldwide network forms: people light up, links draw, signals ripple
          const avatarEls = qa(card, "[data-fx-avatar]");
          const pings = qa(card, "[data-fx-ping]");
          const links = qa(card, "[data-fx-link]");
          const sparks = qa(card, "[data-fx-spark]");
          // .set at position 0 forces arcs + packets back to EMPTY every loop, so
          // they always re-draw from 0 (loop 2, 3, ... behave like the first)
          tl.set(links, { strokeDashoffset: 1, opacity: 1 })
            .set(sparks, { strokeDashoffset: 1, opacity: 0 });
          // arcs draw outward toward each city
          links.forEach((ln, i) => {
            tl.to(ln, { strokeDashoffset: 0, duration: 0.55, ease: "power2.out" }, 0.15 + i * 0.16);
          });
          tl.to(avatarEls, { scale: 1.18, duration: 0.3, stagger: { each: 0.14 }, yoyo: true, repeat: 1, ease: "back.out(3)", transformOrigin: "50% 50%" }, 0.1)
            .fromTo(pings, { scale: 0.7, opacity: 0.6 }, { scale: 2.1, opacity: 0, duration: 1.1, stagger: 0.16, ease: "power1.out", transformOrigin: "50% 50%", immediateRender: false }, 0.35)
            // a packet of light then runs along every arc, city to city
            .set(sparks, { opacity: 1 }, 0.95)
            .to(sparks, { strokeDashoffset: 0, duration: 0.9, ease: "power1.inOut", stagger: 0.1 }, 0.95)
            .to(sparks, { opacity: 0, duration: 0.25 }, 1.95)
            // arcs shimmer while lit, then fade out only at the very end
            .to(links, { opacity: 0.5, duration: 0.5, yoyo: true, repeat: 1, ease: "sine.inOut" }, 1.5)
            .to(links, { opacity: 0, duration: 0.5 }, 2.7)
            .to({}, { duration: 0.5 });
          break;
        }
        default:
          return null;
      }
      return tl;
    };

    const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
    gsap.utils.toArray<HTMLElement>("[data-feat-card]").forEach((card) => {
      const tl = buildLoop(card, card.dataset.card);
      if (!tl) return;
      const play = () => tl.restart(true);          // (re)start from the top and loop
      const reset = () => { tl.pause(); tl.progress(0); }; // snap back to the static first frame

      if (canHover) {
        // Desktop: animate only while hovered.
        card.addEventListener("pointerenter", play);
        card.addEventListener("pointerleave", reset);
      } else {
        // Mobile/touch: animate only while the card is in view; static otherwise.
        ScrollTrigger.create({
          trigger: card,
          start: "top 75%",
          end: "bottom 25%",
          onEnter: play,
          onEnterBack: play,
          onLeave: reset,
          onLeaveBack: reset,
        });
      }
    });
  }
</script>
