---
import { navLinks } from "../data/navigation";
import { socials } from "../data/socials";
import { socialIconPaths } from "../data/icons";
import { AUDIT_REPORT_URL } from "../data/audit";
import { ui } from "../i18n";
import T from "./T.astro";

const legalLinks = [
  { label: ui.footer.privacy, href: "#" },
  { label: ui.footer.terms, href: "#" },
  { label: ui.footer.compliance, href: "#" },
  { label: ui.footer.audit, href: AUDIT_REPORT_URL, external: true },
];
---
<footer class="relative mx-auto w-full max-w-[1376px] rounded-2xl border border-white/[0.07] bg-[#0f0f0f] overflow-hidden">
  <!-- red glow (#B60000) -->
  <div class="absolute -top-20 right-10 w-[760px] h-[260px] bg-[#b60000]/25 blur-[130px] rounded-[50%] pointer-events-none"></div>

  <!-- Large ghost USDX "X" watermark on the right (cropped), thin lines tracing each segment -->
  <div class="absolute top-1/2 right-0 -translate-y-1/2 translate-x-[22%] w-[440px] sm:w-[620px] pointer-events-none">
    <svg viewBox="0 0 590 510" class="w-full h-auto" fill="none">
      <defs>
        <path id="fx1" pathLength="100" d="M0 1.02059C9.68819 0.639054 22.035 0.948915 31.9041 0.928258L142.794 0.886004C149.874 0.8835 160.613 0.565813 167.376 1.20932L288.59 152.863L334.397 210.05C340.847 217.989 347.231 225.986 353.545 234.04C356.701 238.041 360.317 242.348 363.179 246.529C367.528 253.162 369.468 266.038 365.436 273.257C362.553 278.415 356.117 285.595 352.222 290.381L328.12 320.162L304.858 349.367C301.695 353.282 297.963 358.29 294.606 361.899C289.253 354.447 283.224 347.674 277.398 340.619L258.096 316.832L204.732 251.928L27.4234 35.1576C19.0102 24.9328 7.65754 11.7922 0 1.02059Z" />
        <path id="fx2" pathLength="100" d="M395.343 274.158C399.203 279.893 408.202 290.253 412.736 295.871C424.7 310.857 436.774 325.752 448.954 340.553L522.001 431.574C536.502 449.308 550.793 467.227 564.87 485.321C567.142 488.269 569.639 491.049 571.874 494.022C573.641 496.072 582.503 506.539 583.577 508.285C584.158 508.758 584.115 508.726 584.416 509.427C583.312 510.307 580.432 509.85 578.982 509.844C557.252 509.784 535.477 509.643 513.75 509.672L468.914 509.64C451.168 509.769 433.419 509.766 415.674 509.631C412.964 506.764 409.953 502.886 407.411 499.769C403.01 494.404 398.637 489.011 394.294 483.596L357.821 437.856C345.297 422.087 332.426 405.9 320.112 389.94C315.882 384.456 316.36 371.953 319.808 366.209C322.077 362.438 326.092 357.993 329.111 354.475C333.053 349.896 336.94 345.27 340.775 340.6L376.111 297.483C382.555 289.626 388.683 281.896 395.343 274.158Z" />
        <path id="fx4" pathLength="100" d="M195.066 274.417C196.314 275.294 201.846 282.618 203.188 284.265L223.015 308.428L254.228 345.93C258.769 351.451 263.481 356.976 267.772 362.697C269.557 365.076 270.867 367.567 271.106 370.541C271.509 375.549 271.653 382.359 269.005 386.86C264.862 393.896 258.985 400.472 254.007 406.785C246.117 416.791 238.198 426.338 230.065 436.072C209.879 460.425 190.027 485.07 170.515 510C140.504 509.618 110.491 509.484 80.4788 509.599C54.8784 509.634 28.8421 510.028 3.29029 509.552C10.1005 502.203 19.3994 489.656 26.0153 481.499L74.6026 421.668L144.255 336.65C161.125 316.205 178.759 295.241 195.066 274.417Z" />
        <path id="fx5" pathLength="100" d="M430.235 5.56592C430.749 4.84698 431.272 4.13336 431.798 3.42443C432.665 2.26605 433.66 0.887955 435.119 0.708924C438.319 0.31706 442.063 0.510801 445.305 0.544291C451.761 0.639127 458.218 0.683572 464.671 0.677313L513.145 0.660411C521.578 0.566827 530.012 0.521129 538.445 0.523007C548.539 0.670113 558.636 0.719567 568.733 0.67168C575.548 0.677 583.315 0.91362 590 0C589.443 0.940851 588.765 1.93491 588.163 2.85729C585.642 6.17468 582.89 8.95435 580.25 12.1231L562.863 33.2922L435.922 188.846L402.256 230.489C398.311 235.442 393.19 241.004 389.589 246.056L340.629 185.426L318.963 158.131C318.291 157.297 314.726 152.615 314.127 152.203L313.75 151.033C314.401 148.672 334.716 124.31 337.581 120.743L401.502 41.1896C410.662 29.7808 421.562 17.0943 430.235 5.56592Z" />
      </defs>
      <!-- faint gold body -->
      <g fill="rgba(224,169,60,0.05)">
        <use href="#fx1" /><use href="#fx2" /><use href="#fx4" /><use href="#fx5" />
      </g>
      <!-- thin lights travelling around each segment -->
      <g fill="none" stroke="rgba(246,217,138,0.55)" stroke-width="1" vector-effect="non-scaling-stroke" stroke-dasharray="10 90">
        <use data-logo-line href="#fx1" /><use data-logo-line href="#fx2" /><use data-logo-line href="#fx4" /><use data-logo-line href="#fx5" />
      </g>
    </svg>
  </div>

  <div class="relative px-6 sm:px-10 lg:px-11 py-12 lg:py-[52px] flex flex-col lg:flex-row gap-10 lg:gap-6">
    <!-- Brand -->
    <div class="flex-1 lg:max-w-[680px] flex flex-col gap-6">
      <a href="#hero" class="flex items-center no-underline w-fit">
        <img src="/image/logo-lockup.png" alt="USDX" class="h-9 w-auto" />
      </a>
      <div class="flex flex-col gap-5">
        <h3 class="font-serif font-medium text-[34px] sm:text-[40px] leading-[1.1] tracking-tight max-w-md bg-[linear-gradient(180deg,#fff_0%,rgba(255,255,255,0.4)_100%)] bg-clip-text text-transparent">
          <T t={ui.footer.headline} />
        </h3>
        <p class="text-white text-base leading-[26px] max-w-[491px]">
          <T t={ui.footer.tagline} />
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <span class="inline-flex items-center gap-2 px-3 py-2 rounded-full bg-white/10 text-white text-base">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0bb97c]"></span>
          <T t={ui.footer.status} />
        </span>
        <p class="text-white text-base"><T t={ui.footer.rights} /></p>
      </div>
    </div>

    <!-- Quick Links -->
    <div class="lg:w-[280px] flex flex-col gap-4">
      <h4 class="text-white text-base font-normal"><T t={ui.footer.quickLinks} /></h4>
      <div class="flex flex-col gap-1.5">
        {navLinks.map((link) => (
          <a href={link.href} class="text-white/90 hover:text-white text-base font-medium no-underline transition-colors w-fit">
            <T t={link.label} />
          </a>
        ))}
      </div>
    </div>

    <!-- Legal + Social -->
    <div class="lg:w-[280px] flex flex-col gap-6">
      <div class="flex flex-col gap-4">
        <h4 class="text-white text-base font-normal"><T t={ui.footer.legal} /></h4>
        <div class="flex flex-col gap-1.5">
          {legalLinks.map((link) => (
            <a
              href={link.href}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
              class="text-white/90 hover:text-white text-base font-medium no-underline transition-colors w-fit"
            >
              <T t={link.label} />
            </a>
          ))}
        </div>
      </div>
      <div class="flex flex-col gap-4">
        <h4 class="text-white text-base font-normal"><T t={ui.footer.social} /></h4>
        <div class="flex items-center gap-4">
          {socials.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-white/90 hover:text-white transition-colors no-underline"
              aria-label={social.name}
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d={socialIconPaths[social.icon]} />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  import { gsap } from "gsap";

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduced) {
    // Thin light travelling around each part of the ghost logo
    document.querySelectorAll<SVGElement>("[data-logo-line]").forEach((el, i) => {
      gsap.to(el, { strokeDashoffset: -100, duration: 5 + i * 1.6, ease: "none", repeat: -1 });
    });
  }
</script>
