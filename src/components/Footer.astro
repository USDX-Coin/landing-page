---
import { navLinks } from "../data/navigation";
import { socials } from "../data/socials";
import { socialIconPaths } from "../data/icons";
import { ui } from "../i18n";
import T from "./T.astro";

const legalLinks = [
  { label: ui.footer.privacy, href: "#" },
  { label: ui.footer.terms, href: "#" },
  { label: ui.footer.compliance, href: "#" },
];
---
<footer class="relative mx-auto w-full max-w-[1376px] rounded-2xl border border-white/[0.07] bg-[#0f0f0f] overflow-hidden">
  <!-- red glow (#B60000) -->
  <div class="absolute -top-20 right-10 w-[760px] h-[260px] bg-[#b60000]/25 blur-[130px] rounded-[50%] pointer-events-none"></div>

  <!-- Ghost USDX logo watermark on the right with thin lines tracing each part -->
  <div class="absolute top-1/2 right-0 -translate-y-1/2 translate-x-[18%] w-[300px] h-[300px] sm:w-[440px] sm:h-[440px] pointer-events-none">
    <svg viewBox="0 0 64 64" class="w-full h-full" fill="none">
      <circle cx="32" cy="32" r="31" fill="none" stroke="rgba(224,169,60,0.06)" stroke-width="0.6" />
      <path d="M22.3077 14H14L41.6923 50H50L22.3077 14Z" fill="rgba(224,169,60,0.035)" />
      <path d="M41.6923 14H50L22.3077 50H14L41.6923 14Z" fill="rgba(224,169,60,0.035)" />
      <circle data-logo-line cx="32" cy="32" r="31" fill="none" stroke="rgba(246,217,138,0.55)" stroke-width="1" vector-effect="non-scaling-stroke" pathLength="100" stroke-dasharray="6 94" />
      <path data-logo-line d="M22.3077 14H14L41.6923 50H50L22.3077 14Z" fill="none" stroke="rgba(246,217,138,0.5)" stroke-width="1" vector-effect="non-scaling-stroke" pathLength="100" stroke-dasharray="5 95" />
      <path data-logo-line d="M41.6923 14H50L22.3077 50H14L41.6923 14Z" fill="none" stroke="rgba(246,217,138,0.5)" stroke-width="1" vector-effect="non-scaling-stroke" pathLength="100" stroke-dasharray="5 95" />
    </svg>
  </div>

  <div class="relative px-6 sm:px-10 lg:px-11 py-12 lg:py-[52px] flex flex-col lg:flex-row gap-10 lg:gap-6">
    <!-- Brand -->
    <div class="flex-1 lg:max-w-[680px] flex flex-col gap-6">
      <a href="#hero" class="flex items-center gap-2.5 no-underline w-fit">
        <img src="/image/Logo.svg" alt="USDX" class="w-9 h-9" />
        <span class="font-bold text-2xl tracking-tight text-gold-light">USDX</span>
      </a>
      <div class="flex flex-col gap-5">
        <h3 class="font-serif font-medium text-[34px] sm:text-[40px] leading-[1.1] tracking-tight max-w-md bg-[linear-gradient(180deg,#fff_0%,rgba(255,255,255,0.4)_100%)] bg-clip-text text-transparent">
          <T t={ui.footer.headline} />
        </h3>
        <p class="text-white text-base leading-[26px] max-w-[491px]">
          <T t={ui.footer.tagline} />
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-4">
        <span class="inline-flex items-center gap-2 px-3 py-2 rounded-full bg-white/10 text-white text-base">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0bb97c]"></span>
          <T t={ui.footer.status} />
        </span>
        <p class="text-white text-base"><T t={ui.footer.rights} /></p>
      </div>
    </div>

    <!-- Quick Links -->
    <div class="lg:w-[280px] flex flex-col gap-4">
      <h4 class="text-white text-base font-normal"><T t={ui.footer.quickLinks} /></h4>
      <div class="flex flex-col gap-1.5">
        {navLinks.map((link) => (
          <a href={link.href} class="text-white/90 hover:text-white text-base font-medium no-underline transition-colors w-fit">
            <T t={link.label} />
          </a>
        ))}
      </div>
    </div>

    <!-- Legal + Social -->
    <div class="lg:w-[280px] flex flex-col gap-6">
      <div class="flex flex-col gap-4">
        <h4 class="text-white text-base font-normal"><T t={ui.footer.legal} /></h4>
        <div class="flex flex-col gap-1.5">
          {legalLinks.map((link) => (
            <a href={link.href} class="text-white/90 hover:text-white text-base font-medium no-underline transition-colors w-fit">
              <T t={link.label} />
            </a>
          ))}
        </div>
      </div>
      <div class="flex flex-col gap-4">
        <h4 class="text-white text-base font-normal"><T t={ui.footer.social} /></h4>
        <div class="flex items-center gap-4">
          {socials.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-white/90 hover:text-white transition-colors no-underline"
              aria-label={social.name}
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d={socialIconPaths[social.icon]} />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  import { gsap } from "gsap";

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduced) {
    // Thin light travelling around each part of the ghost logo
    document.querySelectorAll<SVGElement>("[data-logo-line]").forEach((el, i) => {
      gsap.to(el, { strokeDashoffset: -100, duration: 5 + i * 1.6, ease: "none", repeat: -1 });
    });
  }
</script>
