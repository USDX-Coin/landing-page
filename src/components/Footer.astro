---
import { navLinks } from "../data/navigation";
import { socials } from "../data/socials";
import { socialIconPaths } from "../data/icons";
import { ui } from "../i18n";
import T from "./T.astro";

const legalLinks = [
  { label: ui.footer.privacy, href: "#" },
  { label: ui.footer.terms, href: "#" },
  { label: ui.footer.compliance, href: "#" },
];
---
<footer class="relative mx-auto w-full max-w-[1320px] rounded-[28px] border border-white/[0.07] bg-[#0b0b0b] overflow-hidden">
  <!-- subtle red glow -->
  <div class="absolute top-0 right-0 w-[500px] h-[320px] bg-primary/[0.08] blur-[120px] rounded-full pointer-events-none"></div>

  <div class="relative px-6 sm:px-10 lg:px-12 py-12 md:py-14">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-12">
      <!-- Brand -->
      <div class="lg:col-span-5">
        <div class="flex items-center gap-2.5 mb-6">
          <img src="/image/Logo.svg" alt="USDX" class="w-8 h-8" />
          <span class="font-bold text-xl tracking-tight text-gold-light">USDX</span>
        </div>
        <h3 class="font-serif font-medium text-3xl sm:text-[34px] text-white leading-tight tracking-tight max-w-sm">
          <T t={ui.footer.headline} />
        </h3>
        <p class="mt-4 text-gray-400 text-sm leading-relaxed max-w-sm">
          <T t={ui.footer.tagline} />
        </p>
      </div>

      <!-- Quick Links -->
      <div class="lg:col-span-3">
        <h4 class="font-semibold mb-4 text-xs uppercase tracking-widest text-gray-500"><T t={ui.footer.quickLinks} /></h4>
        <div class="flex flex-col gap-3">
          {navLinks.map((link) => (
            <a href={link.href} class="text-gray-300 hover:text-white text-sm no-underline transition-colors w-fit">
              <T t={link.label} />
            </a>
          ))}
        </div>
      </div>

      <!-- Legal -->
      <div class="lg:col-span-2">
        <h4 class="font-semibold mb-4 text-xs uppercase tracking-widest text-gray-500"><T t={ui.footer.legal} /></h4>
        <div class="flex flex-col gap-3">
          {legalLinks.map((link) => (
            <a href={link.href} class="text-gray-300 hover:text-white text-sm no-underline transition-colors w-fit">
              <T t={link.label} />
            </a>
          ))}
        </div>
      </div>

      <!-- Social -->
      <div class="lg:col-span-2">
        <h4 class="font-semibold mb-4 text-xs uppercase tracking-widest text-gray-500"><T t={ui.footer.social} /></h4>
        <div class="flex flex-wrap gap-2.5">
          {socials.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 rounded-lg bg-white/[0.06] hover:bg-white/10 border border-white/10 flex items-center justify-center transition-colors no-underline"
              aria-label={social.name}
            >
              <svg class="w-4 h-4 fill-gray-300" viewBox="0 0 24 24">
                <path d={socialIconPaths[social.icon]} />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-14 pt-6 border-t border-white/[0.06] flex flex-col sm:flex-row items-center gap-4">
      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-white/10 bg-white/[0.04] text-xs text-gray-300">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <T t={ui.footer.status} />
      </span>
      <p class="text-gray-500 text-sm"><T t={ui.footer.rights} /></p>
    </div>
  </div>
</footer>
