---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import Ecosystem from "../components/Ecosystem.astro";
// import Certification from "../components/Certification.astro"; — see note below
import CaseStudy from "../components/CaseStudy.astro";
import TokenInfo from "../components/TokenInfo.astro";
import Team from "../components/Team.astro";
import Faq from "../components/Faq";
import Footer from "../components/Footer.astro";
---
<Layout>
  <div class="min-h-screen bg-bg text-[#e7e7e7]">
    <Navbar client:load />
    <Hero />
    <!-- Below the hero, every section is a floating rounded card on the black
         page; the flex gap + padding form the black gutters between them. -->
    <main class="px-4 sm:px-8 py-4">
      <Features />
      <Ecosystem />
      {/* The "Standar Internasional" band (Certification.astro) was cut by
          request on 13 Aug 2026 — "cukup di bagian feature aja": the ISO card
          in Features is the certification's one home on this page, next to the
          hero credential line. The component is kept (unimported) because it
          documents the TSI+KAN mark placement rules and is the natural spot to
          revisit if the mark's arrival reopens the question. */}
      {/* <Certification /> */}
      {/* TokenInfo renders nothing until the mainnet contract address is
          confirmed — see data/token.ts. Empty cards and invented values are
          exactly what got the token-info submission rejected. */}
      <TokenInfo />
      <CaseStudy />
      {/* Target of the "Tim" nav entry — an anchor to #team, not a page. */}
      <Team />
      <Faq client:visible />
      <Footer />
    </main>
  </div>
</Layout>
