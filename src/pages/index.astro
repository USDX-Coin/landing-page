---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import Ecosystem from "../components/Ecosystem.astro";
import Faq from "../components/Faq";
import Footer from "../components/Footer.astro";
---
<Layout>
  <div class="min-h-screen bg-bg text-[#e7e7e7]">
    <Navbar client:load />
    <Hero />
    <!-- Below the hero, every section is a floating rounded card on the black
         page; the flex gap + padding form the black gutters between them. -->
    <main class="flex flex-col gap-3 sm:gap-4 px-3 sm:px-4 py-3 sm:py-4">
      <Features />
      <Ecosystem />
      <Faq client:visible />
      <Footer />
    </main>
  </div>
</Layout>
