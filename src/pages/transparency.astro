---
// "Dokumen Transparansi dan Audit" — the three headline figures, what the
// reserve is made of, the contract address, the monthly attestation table, and
// the smart-contract audit.
//
// Neither the figures nor the table is hand-maintained in this repo. Both come
// from the public endpoint GET {API_BASE}/api/v1/public/transparency, so the
// flow is: the ledger moves (or the auditor hands over a document) -> it shows
// up here on the next page load. Nothing to commit.
//
// THE RULE THIS PAGE IS BUILT AROUND. A figure that is not known renders as
// "Belum tersedia", in words, in both languages — never as 0, and never as a
// blank. A zero is not a missing number, it is a different claim: "no USDX
// exists", "there are no reserves", "the backing is gone". Every slot below has
// an unavailable state, and the empty states are the ones that ship in the
// static HTML today, because the endpoint is not live yet.
//
// The contract card is the exception: it is static, from src/data/token.ts, and
// deliberately NOT taken from the response. See the note above it.
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";
import T from "../components/T.astro";
import { ui, type Translated } from "../i18n";
import { AUDIT_REPORT_URL } from "../data/audit";
import { COMPANY_LEGAL_NAME } from "../data/company";
import { tokenInfo, polygonscanTokenUrl } from "../data/token";
import {
  RESERVE_BANK,
  RESERVE_COMPOSITION,
  RESERVE_CURRENCY,
  SUPPLY_UNIT,
  TRANSPARENCY_FALLBACK,
  formatAmount,
  formatDateTimeWib,
  formatPegLine,
  formatRatio,
  formatShare,
} from "../data/transparency";

const t = ui.transparency;

// Pre-format the fallback in both languages so the static markup carries the
// same content the browser would render. Null in means null out — the caller
// prints "Belum tersedia" rather than substituting anything.
const bilingual = (
  fn: (value: string, lang: "id" | "en") => string,
  value?: string | null,
): Translated | null => {
  if (!value) return null;
  const id = fn(value, "id");
  const en = fn(value, "en");
  return id && en ? { id, en } : null;
};

/** "<prefix> 10 Agustus 2026, 11.05 WIB", or a plain "no timestamp" line. */
const caption = (prefix: Translated, iso?: string | null): Translated => {
  const stamp = bilingual(formatDateTimeWib, iso);
  if (!stamp) return t.captionUnavailable;
  return { id: `${prefix.id} ${stamp.id}`, en: `${prefix.en} ${stamp.en}` };
};

const fallback = TRANSPARENCY_FALLBACK;

const supplyAmount = bilingual(formatAmount, fallback.circulatingSupply?.amount);
const supplyCaption = caption(t.supplyCaption, fallback.circulatingSupply?.readAt);

const reserveAmount = bilingual(formatAmount, fallback.reserve?.amount);
const reserveCaption = caption(t.reserveCaption, fallback.reserve?.balanceAt);

const ratio = bilingual(formatRatio, fallback.collateralRatio);
const peg = bilingual(formatPegLine, fallback.collateralRatio);
const updatedCaption = caption(t.updatedCaption, fallback.updatedAt);

const composition = RESERVE_COMPOSITION.map((item) => ({
  label: item.label,
  share: bilingual(formatShare, item.share),
}));

const contractAddress = tokenInfo.contractAddress;
const explorerUrl = contractAddress ? polygonscanTokenUrl(contractAddress) : "";

const cardClass =
  "relative mx-auto w-full max-w-[1376px] rounded-2xl border border-white/[0.07] bg-[#0f0f0f] overflow-hidden";
const figureCardClass =
  "rounded-2xl border border-white/[0.07] bg-[#0f0f0f] p-6 sm:p-8 flex flex-col gap-2";
const figureLabelClass = "text-white/55 text-sm";
const figureValueClass = "text-white font-serif font-medium text-3xl sm:text-[40px] leading-tight m-0";
// Unit and currency sit beside the number, and are hidden whenever the number
// itself is unavailable — "Belum tersedia USDX" is not a sentence.
//
// Both are printed from the repo's own constants and are never rewritten by the
// browser script. They are the labels that say what the number MEANS, and a
// label that arrives over the network is one an upstream mistake can change
// under a figure that stays put. A response naming a different unit or currency
// costs that figure its slot instead — see buildFiguresView.
const figureAffixClass = "text-white/50 text-xl";
// `mt-auto` pins every caption to the bottom of its card, so the three line up
// even though the ratio card carries an extra line above it.
const captionClass = "text-white/45 text-xs leading-5 m-0 mt-auto pt-2";
const sectionHeadingClass = "font-serif font-medium text-3xl sm:text-4xl tracking-tight text-white m-0";
const rowLabelClass = "text-white/55 text-sm m-0";
// Rows sit in a hug-the-content grid, so the value starts right after its label
// instead of being pushed to the far edge of the card.
const rowValueClass = "text-white text-sm font-medium m-0 break-words";
const thClass = "text-left text-white/55 text-xs font-medium uppercase tracking-wide px-4 py-3";
---
<Layout pageMeta={{ title: t.metaTitle, description: t.metaDescription }}>
  <div class="min-h-screen bg-bg text-[#e7e7e7]">
    <Navbar client:load base="/" />

    <main class="px-4 sm:px-8 pt-[104px] pb-4 flex flex-col gap-4">
      <!-- Header -->
      <section class={cardClass}>
        <div class="absolute -top-20 right-10 w-[560px] h-[240px] bg-[#b60000]/20 blur-[130px] rounded-[50%] pointer-events-none"></div>
        <div class="relative px-6 sm:px-10 lg:px-11 py-12 lg:py-[52px] flex flex-col gap-6 max-w-[760px]">
          <span
            class="inline-flex w-fit items-center gap-3 pl-2 pr-5 py-2 rounded-full text-white text-base font-medium font-tight"
            style="background-image:linear-gradient(90deg,rgba(239,183,79,0.4) 0%,rgba(98,0,0,0) 100%)"
          >
            <span class="w-7 h-7 rounded-full bg-[#F7A100] flex items-center justify-center text-white shrink-0">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z" />
              </svg>
            </span>
            <T t={t.eyebrow} />
          </span>
          <h1 class="font-serif font-medium text-4xl sm:text-5xl lg:text-[56px] lg:leading-[60px] tracking-tight bg-[linear-gradient(180deg,#fff_0%,rgba(255,255,255,0.4)_100%)] bg-clip-text text-transparent m-0">
            <span class="block"><T t={t.heading1} /></span>
            <span class="block"><T t={t.heading2} /></span>
          </h1>
          <p class="text-white/80 text-base leading-[26px] m-0"><T t={t.intro} /></p>
          <p class="text-white/50 text-sm leading-5 m-0" data-tp-status><T t={t.statusLoading} /></p>
          <noscript>
            <p class="text-white/50 text-sm leading-5 m-0"><T t={t.statusNoJs} /></p>
          </noscript>
        </div>
      </section>

      <!-- Headline figures: circulating supply, reserve assets, collateral
           ratio. Each ships with its unavailable state and is filled in by
           applyFigures() once the API answers. -->
      <section class="mx-auto w-full max-w-[1376px] grid gap-4 md:grid-cols-3">
        <div class={figureCardClass}>
          <span class={figureLabelClass}><T t={t.supplyLabel} /></span>
          <p class={figureValueClass}>
            <span data-tp="supply">{supplyAmount ? <T t={supplyAmount} /> : <T t={t.notAvailable} />}</span><span
              data-tp-affix="supply"
              class={`${figureAffixClass} ml-2 ${supplyAmount ? "" : "hidden"}`}
            >{SUPPLY_UNIT}</span>
          </p>
          <p class={captionClass}><span data-tp="supply-caption"><T t={supplyCaption} /></span></p>
        </div>

        <div class={figureCardClass}>
          <span class={figureLabelClass}><T t={t.reserveLabel} /></span>
          <p class={figureValueClass}>
            <span
              data-tp-affix="reserve"
              class={`${figureAffixClass} mr-2 ${reserveAmount ? "" : "hidden"}`}
            >{RESERVE_CURRENCY}</span><span data-tp="reserve">{reserveAmount ? <T t={reserveAmount} /> : <T t={t.notAvailable} />}</span>
          </p>
          <p class={captionClass}><span data-tp="reserve-caption"><T t={reserveCaption} /></span></p>
        </div>

        <div class={figureCardClass}>
          <span class={figureLabelClass}><T t={t.ratioLabel} /></span>
          <p class={`text-gold font-serif font-medium text-3xl sm:text-[40px] leading-tight m-0`}>
            <span data-tp="ratio">{ratio ? <T t={ratio} /> : <T t={t.notAvailable} />}</span>
          </p>
          {/* Derived from the ratio, so it disappears with it. An unknown ratio
              rendered as "1 USDX = USD 0,00" would announce a total loss of
              backing where there is only a missing figure. */}
          <p data-tp-peg-row class={`text-white/70 text-sm leading-5 m-0 ${peg ? "" : "hidden"}`}>
            <span data-tp="peg">{peg && <T t={peg} />}</span>
          </p>
          <p class={captionClass}><span data-tp="updated-caption"><T t={updatedCaption} /></span></p>
        </div>
      </section>

      <!-- Attestation documents -->
      <section class={cardClass}>
        <div class="relative px-6 sm:px-10 lg:px-11 py-10 lg:py-12 flex flex-col gap-5">
          <h2 class={sectionHeadingClass}><T t={t.docsHeading} /></h2>

          {/* Hidden until there is at least one row — an empty table with
              headers and nothing under them looks broken. */}
          <div data-doc-table-wrap class="hidden overflow-x-auto -mx-2 px-2">
            <table class="w-full border-collapse min-w-[640px]">
              <thead>
                <tr class="border-b border-white/10">
                  <th scope="col" class={`${thClass} w-28`}><T t={t.colId} /></th>
                  <th scope="col" class={thClass}><T t={t.colName} /></th>
                  <th scope="col" class={`${thClass} w-32`}><T t={t.colMonth} /></th>
                  <th scope="col" class={`${thClass} w-24`}><T t={t.colYear} /></th>
                  <th scope="col" class={`${thClass} w-32 text-right`}><T t={t.colAction} /></th>
                </tr>
              </thead>
              <tbody data-doc-rows></tbody>
            </table>
          </div>

          <p data-doc-id-note class="hidden text-white/45 text-xs leading-5 m-0"><T t={t.idNote} /></p>

          {/* Four mutually exclusive states, and which one ships in the static
              HTML matters. The table is built entirely in the browser from the
              API response, so anything visible here by default is what a
              crawler, a link-preview bot, or a reviewer with JavaScript off will
              read as the page's answer.

              "empty" used to be that default — it shipped VISIBLE and
              unconditional, telling every one of those readers that no
              attestation had ever been published, however many actually had.
              The initial state is now "pending", which claims nothing: it only
              says where the list comes from. applyAttestations() then reveals
              exactly one of the table, "empty" or "unavailable", and a failed
              fetch leaves "pending" standing next to the status line that
              explains it.

              "empty" and "unavailable" are separate on purpose, and the
              separation is the whole point of the state machine: "no document
              has been published yet" is a statement about USDX, reachable only
              from a list the API actually sent with nothing in it. A missing or
              unreadable list gets "unavailable", which states nothing about how
              many reports exist. The two shared one sentence until recently,
              and it was the wrong one. */}
          <p data-doc-empty class="hidden text-white/55 text-sm leading-6 m-0"><T t={t.empty} /></p>

          <p data-doc-unavailable class="hidden text-white/55 text-sm leading-6 m-0"><T t={t.listUnavailable} /></p>

          <p data-doc-pending class="text-white/55 text-sm leading-6 m-0"><T t={t.listPending} /></p>
        </div>
      </section>

      <section class="mx-auto w-full max-w-[1376px] grid gap-4 lg:grid-cols-2">
        <!-- What the reserve is made of. Static copy, not a live figure: the
             locked public payload carries no composition field, and "100% U.S.
             dollar cash at BNI" is a statement from the official documentation
             rather than a balance. See RESERVE_COMPOSITION. -->
        <div class="rounded-2xl border border-white/[0.07] bg-[#0f0f0f] p-6 sm:p-8 flex flex-col gap-5">
          <h2 class={sectionHeadingClass}><T t={t.reserveHeading} /></h2>
          <ul class="list-none p-0 m-0 flex flex-col gap-3">
            {composition.map((item) => (
              <li class="flex items-baseline justify-between gap-4 border-b border-white/[0.06] pb-3 last:border-0 last:pb-0">
                <span class="text-white text-sm leading-6"><T t={item.label} /></span>
                <span class="text-white text-sm font-medium tabular-nums shrink-0">
                  {item.share ? <T t={item.share} /> : "—"}
                </span>
              </li>
            ))}
          </ul>
          <dl class="grid grid-cols-[max-content_1fr] gap-x-10 gap-y-3 m-0">
            <dt class={rowLabelClass}><T t={t.reserveBank} /></dt>
            {/* Where the reserves are held is a fact about USDX, not a figure,
                so it is named even before the API answers — and it is named
                from the repo's constant, never from `reserve.custodian` in the
                response. The contract hardcodes that field server-side so no
                free-text staff input can carry an account number onto a public
                page; rendering the local constant means no value from the
                network reaches this line at all. The browser script does not
                touch it. */}
            <dd class={rowValueClass}>{RESERVE_BANK}</dd>

            <dt class={rowLabelClass}><T t={t.issuer} /></dt>
            <dd class={rowValueClass}>{COMPANY_LEGAL_NAME}</dd>
          </dl>
          <p class="text-white/60 text-sm leading-6 m-0"><T t={t.reserveCompositionNote} /></p>
        </div>

        <!-- Contract address — the first thing an explorer reviewer looks for.

             STATIC, from src/data/token.ts, and deliberately not taken from the
             API response even though the response carries a token block. There
             are two USDX deployments on Polygon mainnet, and this same static
             build is served on preview hosts that talk to the DEV backend,
             which still points at the abandoned 0x2702… deployment. Letting the
             response set this value would put a dead address under a
             USDX-branded "Contract Address" heading — the one field on this
             page a reader cannot check without being told it first, and the
             exact thing address-swap scams rely on. It changes when a human
             changes it in the repo, with DEPLOYED.md open. -->
        <div class="rounded-2xl border border-white/[0.07] bg-[#0f0f0f] p-6 sm:p-8 flex flex-col gap-5">
          <h2 class={sectionHeadingClass}><T t={t.contractHeading} /></h2>
          <dl class="grid grid-cols-[max-content_1fr] gap-x-10 gap-y-3 m-0">
            <dt class={rowLabelClass}><T t={ui.token.network} /></dt>
            <dd class={rowValueClass}>{tokenInfo.network}</dd>

            <dt class={rowLabelClass}><T t={ui.token.symbol} /></dt>
            <dd class={rowValueClass}>{tokenInfo.symbol}</dd>

            <dt class={rowLabelClass}><T t={ui.token.decimals} /></dt>
            <dd class={rowValueClass}>{String(tokenInfo.decimals)}</dd>
          </dl>
          <div class="flex flex-col gap-2">
            <span class={rowLabelClass}><T t={ui.token.contractAddress} /></span>
            <code class="block break-all rounded-lg bg-black/50 border border-white/10 px-3 py-2.5 text-white text-[13px] leading-5 font-mono">{contractAddress}</code>
          </div>
          {explorerUrl && (
            <a
              href={explorerUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex w-fit items-center gap-2 px-4 py-2.5 rounded-lg border border-white/15 hover:border-white/35 text-white text-sm font-medium transition-colors no-underline"
            >
              <T t={ui.token.explorer} />
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5h5v5M19 5l-8 8M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
              </svg>
            </a>
          )}
        </div>
      </section>

      <!-- How the figures are read -->
      <section class={cardClass}>
        <div class="relative px-6 sm:px-10 lg:px-11 py-10 lg:py-12 flex flex-col gap-6">
          <h2 class={sectionHeadingClass}><T t={t.methodHeading} /></h2>
          <div class="grid gap-6 lg:grid-cols-2">
            <div class="flex flex-col gap-2">
              <h3 class="text-white text-base font-medium m-0"><T t={t.supplyDefinitionTitle} /></h3>
              <p class="text-white/70 text-sm leading-6 m-0"><T t={t.supplyDefinition} /></p>
            </div>
            <div class="flex flex-col gap-2">
              <h3 class="text-white text-base font-medium m-0"><T t={t.ratioDefinitionTitle} /></h3>
              <p class="text-white/70 text-sm leading-6 m-0"><T t={t.ratioDefinition} /></p>
            </div>
          </div>
        </div>
      </section>

      <!-- Smart contract audit -->
      <section class={cardClass}>
        <div class="relative px-6 sm:px-10 lg:px-11 py-10 lg:py-12 flex flex-col gap-4 items-start">
          <h2 class={sectionHeadingClass}><T t={t.auditHeading} /></h2>
          <p class="text-white/70 text-sm leading-6 m-0 max-w-[640px]"><T t={t.auditBody} /></p>
          <a
            href={AUDIT_REPORT_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-primary hover:bg-primary-dark text-white text-sm font-medium transition-colors no-underline"
          >
            <T t={ui.footer.audit} />
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </section>

      <Footer base="/" />
    </main>
  </div>
</Layout>

<script>
  // The BROWSER SIDE of /transparency, and deliberately nothing but wiring.
  //
  // Every decision — what a figure reads, which of the attestation card's four
  // states to show, which status line goes with them — is made by pure functions
  // in ../data/transparencyView.ts, where tests can reach them. Code that lives
  // inside this block cannot be imported, and the two worst bugs this page has
  // had both lived here for exactly that reason. What is left is DOM writing:
  // put this string in that element, show this one, hide that one.
  import { ui, type Lang, type Translated } from "../i18n";
  import { resolveApiBaseUrl, TRANSPARENCY_PATH, type TransparencyEnvelope } from "../data/transparency";
  import {
    buildView,
    type AttestationRow,
    type AttestationsView,
    type FiguresView,
    type TransparencyStatus,
  } from "../data/transparencyView";

  const t = ui.transparency;

  const STATUS_LINE: Record<TransparencyStatus, Translated> = {
    live: t.statusLive,
    partial: t.statusLivePartial,
  };

  /**
   * Write a value into every `[data-tp="<key>"]` slot. Translated values render
   * as the site's two `[data-l]` spans so the language switcher keeps working.
   * Always built with textContent — the API is trusted, but never trusted enough
   * to be injected as HTML.
   */
  function setValue(key: string, value: string | Translated) {
    document.querySelectorAll<HTMLElement>(`[data-tp="${key}"]`).forEach((el) => {
      if (typeof value === "string") {
        el.textContent = value;
        return;
      }
      el.replaceChildren(langSpan("id", value.id), langSpan("en", value.en));
    });
  }

  function langSpan(lang: Lang, text: string): HTMLSpanElement {
    const span = document.createElement("span");
    span.dataset.l = lang;
    span.textContent = text;
    return span;
  }

  function bilingualNode(value: Translated): DocumentFragment {
    const fragment = document.createDocumentFragment();
    fragment.append(langSpan("id", value.id), langSpan("en", value.en));
    return fragment;
  }

  function show(selector: string, visible: boolean) {
    document
      .querySelectorAll<HTMLElement>(selector)
      .forEach((el) => el.classList.toggle("hidden", !visible));
  }

  function setStatus(message: Translated) {
    const el = document.querySelector<HTMLElement>("[data-tp-status]");
    if (el) el.replaceChildren(bilingualNode(message));
  }

  // ── Figures ────────────────────────────────────────────────────────────────

  /**
   * Fill one headline figure. When the value is missing, the number reads
   * "Belum tersedia" and its unit/currency is hidden with it, so nothing on
   * screen ever reads "Belum tersedia USDX" — or, worse, "USD 0,00".
   */
  function setFigure(key: string, value: Translated | null, affix?: string) {
    setValue(key, value ?? t.notAvailable);
    if (affix) show(`[data-tp-affix="${affix}"]`, value !== null);
  }

  function applyFigures(figures: FiguresView) {
    setFigure("supply", figures.supply, "supply");
    setValue("supply-caption", figures.supplyCaption);

    setFigure("reserve", figures.reserve, "reserve");
    setValue("reserve-caption", figures.reserveCaption);

    setFigure("ratio", figures.ratio);
    if (figures.peg) setValue("peg", figures.peg);
    show("[data-tp-peg-row]", figures.peg !== null);

    setValue("updated-caption", figures.updatedCaption);

    // The unit, the currency and the bank the reserves are held at are printed
    // from the repo's own constants in the static markup, and nothing here
    // overwrites them. See the note beside RESERVE_BANK.
  }

  // ── Attestation table ──────────────────────────────────────────────────────

  function cell(className: string): HTMLTableCellElement {
    const td = document.createElement("td");
    td.className = className;
    return td;
  }

  function rowNode(row: AttestationRow): HTMLTableRowElement {
    const tr = document.createElement("tr");
    tr.className = "border-b border-white/[0.06] last:border-0";

    const idCell = cell("px-4 py-4 text-white/45 text-sm tabular-nums align-middle");
    idCell.textContent = row.id;

    const nameCell = cell("px-4 py-4 text-white text-sm font-medium align-middle");
    nameCell.textContent = row.title;

    const monthCell = cell("px-4 py-4 text-white/70 text-sm align-middle");
    monthCell.append(bilingualNode(row.month));

    const yearCell = cell("px-4 py-4 text-white/70 text-sm tabular-nums align-middle");
    yearCell.textContent = row.year;

    const actionCell = cell("px-4 py-4 text-right align-middle");
    if (row.href) {
      const link = document.createElement("a");
      link.href = row.href;
      link.target = "_blank";
      link.rel = "noopener noreferrer";
      link.className =
        "inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-primary hover:bg-primary-dark text-white text-sm font-medium no-underline transition-colors";
      link.append(bilingualNode(t.download));
      actionCell.append(link);
    } else {
      // No usable file link: say so rather than render a button that goes
      // nowhere.
      const dash = document.createElement("span");
      dash.className = "text-white/35 text-sm";
      dash.textContent = "—";
      actionCell.append(dash);
    }

    tr.append(idCell, nameCell, monthCell, yearCell, actionCell);
    return tr;
  }

  function applyAttestations(view: AttestationsView) {
    const body = document.querySelector<HTMLTableSectionElement>("[data-doc-rows]");
    if (!body) return;

    const isList = view.state === "list";
    // Rows go in BEFORE anything is revealed, so the card can never be shown
    // around an empty table. The old code hid the "loading" line first and then
    // threw partway through building the rows, leaving a bare 98px box with
    // nothing in it and no sentence to explain it.
    if (view.state === "list") body.replaceChildren(...view.rows.map(rowNode));

    show("[data-doc-table-wrap]", isList);
    show("[data-doc-id-note]", isList);
    show("[data-doc-empty]", view.state === "empty");
    show("[data-doc-unavailable]", view.state === "unavailable");
    show("[data-doc-pending]", false);
  }

  async function load() {
    const apiBaseUrl = resolveApiBaseUrl(window.location.hostname);
    let view: ReturnType<typeof buildView> = null;
    try {
      const response = await fetch(`${apiBaseUrl}${TRANSPARENCY_PATH}`, {
        headers: { Accept: "application/json" },
        // Public, unauthenticated endpoint — no cookies should ride along.
        credentials: "omit",
      });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const body = (await response.json()) as TransparencyEnvelope;
      view = buildView(body?.data, apiBaseUrl);
      if (!view) throw new Error("empty payload");
    } catch {
      // Nothing usable arrived. Leave whatever is baked into the HTML in place
      // and say so plainly: the figure slots keep their "Belum tersedia"
      // wording rather than collapsing to zero, the document list keeps its
      // "loaded from the API" line rather than claiming none exists, and the
      // contract card is static, so the page stays whole.
      //
      // ONLY the fetch and the reading of it sit in this try. Rendering does
      // not, because a failure while rendering used to be reported as a failure
      // to LOAD: the figures were already on screen, filled from the response,
      // under a status line announcing that they could not be shown. Everything
      // below this point is total — buildView never throws — so the status line
      // and the screen agree.
      setStatus(t.statusFallback);
      return;
    }

    applyFigures(view.figures);
    applyAttestations(view.attestations);
    setStatus(STATUS_LINE[view.status]);
  }

  void load();
</script>
