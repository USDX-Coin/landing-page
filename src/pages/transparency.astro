---
// "Dokumen Transparansi dan Audit" — the three headline figures, what the
// reserve is made of, the contract address, the smart-contract audit, and the
// table of published reserve attestation reports.
//
// The figures are not hand-maintained in this repo. They come from the public
// endpoint GET {API_BASE}/api/v1/public/transparency, so the flow is: the
// ledger moves -> it shows up here on the next page load. Nothing to commit.
//
// The attestation table at the bottom is static as well, from
// ATTESTATION_REPORTS in src/data/audit.ts. The "Laporan Atestasi Bulanan"
// table that used to sit under the figures was removed on 30 Sep 2026: that one
// was built from the same response's `attestations` list, which this page no
// longer reads — see CLAUDE.md for the way back.
//
// THE RULE THIS PAGE IS BUILT AROUND. A figure that is not known renders as
// "Belum tersedia", in words, in both languages — never as 0, and never as a
// blank. A zero is not a missing number, it is a different claim: "no USDX
// exists", "there are no reserves", "the backing is gone". Every slot below has
// an unavailable state, and the empty states are the ones that ship in the
// static HTML today, because the endpoint is not live yet.
//
// The contract card is the exception: it is static, from src/data/token.ts, and
// deliberately NOT taken from the response. See the note above it.
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";
import T from "../components/T.astro";
import { ui, type Translated } from "../i18n";
import { AUDIT_REPORT_URL, ATTESTATION_REPORTS } from "../data/audit";
import { COMPANY_LEGAL_NAME } from "../data/company";
import { tokenInfo, polygonscanTokenUrl } from "../data/token";
import {
  RESERVE_BANK,
  RESERVE_COMPOSITION,
  RESERVE_CURRENCY,
  SUPPLY_UNIT,
  TRANSPARENCY_FALLBACK,
  formatAmount,
  formatDateTimeWib,
  formatPegLine,
  formatRatio,
  formatShare,
} from "../data/transparency";

const t = ui.transparency;

// Pre-format the fallback in both languages so the static markup carries the
// same content the browser would render. Null in means null out — the caller
// prints "Belum tersedia" rather than substituting anything.
const bilingual = (
  fn: (value: string, lang: "id" | "en") => string,
  value?: string | null,
): Translated | null => {
  if (!value) return null;
  const id = fn(value, "id");
  const en = fn(value, "en");
  return id && en ? { id, en } : null;
};

/** "<prefix> 10 Agustus 2026, 11.05 WIB", or a plain "no timestamp" line. */
const caption = (prefix: Translated, iso?: string | null): Translated => {
  const stamp = bilingual(formatDateTimeWib, iso);
  if (!stamp) return t.captionUnavailable;
  return { id: `${prefix.id} ${stamp.id}`, en: `${prefix.en} ${stamp.en}` };
};

const fallback = TRANSPARENCY_FALLBACK;

const supplyAmount = bilingual(formatAmount, fallback.circulatingSupply?.amount);
const supplyCaption = caption(t.supplyCaption, fallback.circulatingSupply?.readAt);

const reserveAmount = bilingual(formatAmount, fallback.reserve?.amount);
const reserveCaption = caption(t.reserveCaption, fallback.reserve?.balanceAt);

const ratio = bilingual(formatRatio, fallback.collateralRatio);
const peg = bilingual(formatPegLine, fallback.collateralRatio);
const updatedCaption = caption(t.updatedCaption, fallback.updatedAt);

const composition = RESERVE_COMPOSITION.map((item) => ({
  label: item.label,
  share: bilingual(formatShare, item.share),
}));

const contractAddress = tokenInfo.contractAddress;
const explorerUrl = contractAddress ? polygonscanTokenUrl(contractAddress) : "";

// ── The page's surfaces, and why they are these values ──────────────────────
//
// This page is read, not skimmed: it is nothing but figures, label–value pairs
// and a table. Its text contrast was never the problem — the body copy measured
// 6.24 against its card and the row labels 4.53, both of which pass WCAG AA.
// What was missing was SURFACE SEPARATION. Cards were #0f0f0f on a #0a0a0a
// page, a contrast ratio of 1.033 where 1.00 means "invisible", edged with a
// border at white/[0.07] worth 1.176 against the card it sat on. The whole page
// was therefore one unbroken black field: nothing told the eye where one block
// ended and the next began, which is tiring in a way that no per-element
// contrast check can see.
//
// Two levers were available, and they are not worth the same:
//
//   SURFACE STEP is weak in this range. Going from #0f0f0f all the way to
//   #1c1c20 buys only 1.033 -> 1.166, and every step costs text contrast on top
//   of it (white/45 falls 4.53 -> 4.43, below where the captions already sat).
//
//   THE EDGE is where the value is. A border at white/[0.12] is 1.419 against
//   its card — more separation than the entire surface range offers — and it is
//   a hard boundary, which is what the eye actually reads a card by. It costs
//   the text nothing.
//
// So the surface is lifted to #17171a (1.107 against the page, and text on it
// still measures 6.13 at white/55, 5.26 at white/50) and most of the work is
// given to a border that is genuinely visible. Keep both if either is touched:
// the surface alone is too subtle to carry a card, and a border alone floats.
//
// The page stays near-black on purpose. It is the brand, and the fix here is
// separation, not brightness.
const SURFACE = "border border-white/[0.12] bg-[#17171a]";
/** Hairlines INSIDE a card: table rows, list separators, caption rules. */
const DIVIDER = "border-white/[0.10]";

const cardClass = `relative mx-auto w-full max-w-[1376px] rounded-2xl ${SURFACE} overflow-hidden`;
const figureCardClass = `rounded-2xl ${SURFACE} p-6 sm:p-7 flex flex-col gap-3`;
// ── The type scale, and the four roles it has to keep apart ─────────────────
//
// Everything on this page used to be 12–14px, which left a figure's label, a
// row's label and a paragraph of prose all looking like the same kind of thing.
// Four roles now read differently at a glance, before a word of any of them is
// read:
//
//   LABEL    small, dim, uppercase, tracked — names a number, is never one
//   VALUE    16px, white, medium — the answer
//   PROSE    16px/28, white/70 — sentences, capped at ~62 characters a line
//   CAPTION  13px, white/50, under a rule — the timestamp and the footnotes
//
// Uppercase is what makes a label unmistakably a label rather than a short
// sentence. It is a CSS transform: the strings in i18n.ts are untouched and
// screen readers still get the original words.
const figureLabelClass =
  "text-white/60 text-xs font-semibold uppercase tracking-[0.08em] leading-5";
const figureValueClass = "text-white font-serif font-medium text-3xl sm:text-[40px] leading-tight m-0";
// Unit and currency sit beside the number, and are hidden whenever the number
// itself is unavailable — "Belum tersedia USDX" is not a sentence.
//
// Both are printed from the repo's own constants and are never rewritten by the
// browser script. They are the labels that say what the number MEANS, and a
// label that arrives over the network is one an upstream mistake can change
// under a figure that stays put. A response naming a different unit or currency
// costs that figure its slot instead — see buildFiguresView.
const figureAffixClass = "text-white/55 text-xl";
// `mt-auto` pins every caption to the bottom of its card, so the three line up
// even though the ratio card carries an extra line above it. That left a void
// of dead space in the two shorter cards; the rule turns it into a footer, so
// the gap now reads as structure rather than as something failing to load.
const captionClass = `text-white/50 text-[13px] leading-5 m-0 mt-auto pt-4 border-t ${DIVIDER}`;
const sectionHeadingClass = "font-serif font-medium text-3xl sm:text-4xl tracking-tight text-white m-0";
// ── Label–value rows ────────────────────────────────────────────────────────
//
// From `sm` up these sit in a hug-the-content grid, so the value starts right
// after its label instead of being pushed to the far edge of the card.
//
// BELOW `sm` THEY STACK. Two columns at 390px left the value with about 150px
// to live in, which turned "Bank Negara Indonesia (BNI)" and "PT Macan Asia
// Finance" into three ragged lines each — and raising the value to 16px would
// have made that worse, not better. Stacked, each value gets the full card
// width. The margins below carry the rhythm the grid's `gap-y` carries on
// wider screens: a pair holds together (8px) and pairs stand apart (20px).
const rowGridClass =
  "grid grid-cols-1 gap-x-8 gap-y-2 sm:grid-cols-[max-content_1fr] sm:gap-y-4 m-0";
const rowLabelClass = "text-white/60 text-sm leading-6 m-0 mt-3 first:mt-0 sm:mt-0";
const rowValueClass = "text-white text-base font-medium leading-6 m-0 break-words";
/** Sentences. Capped near 62 characters — the cards are 1376px wide. */
const proseClass = "text-white/70 text-base leading-7 m-0 max-w-[62ch]";
// Column headers are LABELS, so they take the label treatment of the figure
// cards above: small, uppercase, tracked.
const thClass =
  "text-left text-white/60 text-xs font-semibold uppercase tracking-[0.08em] px-4 py-3.5";
const tdClass = "px-4 py-4.5 text-[15px] align-middle";
---
<Layout pageMeta={{ title: t.metaTitle, description: t.metaDescription }}>
  <div class="min-h-screen bg-bg text-[#e7e7e7]">
    <Navbar client:load base="/" />

    <!-- gap-6 between blocks, not gap-4. With cards that were invisible the
         page had nothing but this gap to separate one block from the next, and
         16px was not enough to do it alone. Now the cards carry their own edge
         and the gap only has to give them room to breathe. -->
    <main class="px-4 sm:px-8 pt-[104px] pb-5 sm:pb-6 flex flex-col gap-5 sm:gap-6">
      <!-- Header -->
      <section class={cardClass}>
        <div class="absolute -top-20 right-10 w-[560px] h-[240px] bg-[#b60000]/20 blur-[130px] rounded-[50%] pointer-events-none"></div>
        <div class="relative px-6 sm:px-10 lg:px-11 py-12 lg:py-[52px] flex flex-col gap-6">
          <span
            class="inline-flex w-fit items-center gap-3 pl-2 pr-5 py-2 rounded-full text-white text-base font-medium font-tight"
            style="background-image:linear-gradient(90deg,rgba(239,183,79,0.4) 0%,rgba(98,0,0,0) 100%)"
          >
            <span class="w-7 h-7 rounded-full bg-[#F7A100] flex items-center justify-center text-white shrink-0">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7l5 5v11a2 2 0 0 1-2 2Z" />
              </svg>
            </span>
            <T t={t.eyebrow} />
          </span>
          <h1 class="font-serif font-medium text-4xl sm:text-5xl lg:text-[56px] lg:leading-[60px] tracking-tight bg-[linear-gradient(180deg,#fff_0%,rgba(255,255,255,0.4)_100%)] bg-clip-text text-transparent m-0 max-w-[760px]">
            <span class="block"><T t={t.heading1} /></span>
            <span class="block"><T t={t.heading2} /></span>
          </h1>
          <p class="text-white/80 text-base leading-7 m-0 max-w-[62ch]"><T t={t.intro} /></p>
          {/* The status line is a caption about the whole page, not a fourth
              sentence of the intro — which is how 14px grey text sitting
              directly under a 16px paragraph read. It gets the same treatment
              as the figure timestamps (13px, white/50, under a rule), and the
              rule runs the full width of the card rather than stopping at the
              end of the prose column, so it separates two parts of the card
              instead of hanging in the middle of one. */}
          <p
            class={`text-white/50 text-[13px] leading-5 m-0 pt-4 border-t ${DIVIDER}`}
            data-tp-status
          ><T t={t.statusLoading} /></p>
          <noscript>
            <p class="text-white/50 text-[13px] leading-5 m-0"><T t={t.statusNoJs} /></p>
          </noscript>
        </div>
      </section>

      <!-- Headline figures: circulating supply, reserve assets, collateral
           ratio. Each ships with its unavailable state and is filled in by
           applyFigures() once the API answers. -->
      <section class="mx-auto w-full max-w-[1376px] grid gap-5 sm:gap-6 md:grid-cols-3">
        <div class={figureCardClass}>
          <span class={figureLabelClass}><T t={t.supplyLabel} /></span>
          <p class={figureValueClass}>
            <span data-tp="supply">{supplyAmount ? <T t={supplyAmount} /> : <T t={t.notAvailable} />}</span><span
              data-tp-affix="supply"
              class={`${figureAffixClass} ml-2 ${supplyAmount ? "" : "hidden"}`}
            >{SUPPLY_UNIT}</span>
          </p>
          <p class={captionClass}><span data-tp="supply-caption"><T t={supplyCaption} /></span></p>
        </div>

        <div class={figureCardClass}>
          <span class={figureLabelClass}><T t={t.reserveLabel} /></span>
          <p class={figureValueClass}>
            <span
              data-tp-affix="reserve"
              class={`${figureAffixClass} mr-2 ${reserveAmount ? "" : "hidden"}`}
            >{RESERVE_CURRENCY}</span><span data-tp="reserve">{reserveAmount ? <T t={reserveAmount} /> : <T t={t.notAvailable} />}</span>
          </p>
          <p class={captionClass}><span data-tp="reserve-caption"><T t={reserveCaption} /></span></p>
        </div>

        <div class={figureCardClass}>
          <span class={figureLabelClass}><T t={t.ratioLabel} /></span>
          <p class={`text-gold font-serif font-medium text-3xl sm:text-[40px] leading-tight m-0`}>
            <span data-tp="ratio">{ratio ? <T t={ratio} /> : <T t={t.notAvailable} />}</span>
          </p>
          {/* Derived from the ratio, so it disappears with it. An unknown ratio
              rendered as "1 USDX = USD 0,00" would announce a total loss of
              backing where there is only a missing figure. */}
          <p data-tp-peg-row class={`text-white/70 text-[15px] leading-6 m-0 ${peg ? "" : "hidden"}`}>
            <span data-tp="peg">{peg && <T t={peg} />}</span>
          </p>
          <p class={captionClass}><span data-tp="updated-caption"><T t={updatedCaption} /></span></p>
        </div>
      </section>

      <section class="mx-auto w-full max-w-[1376px] grid gap-5 sm:gap-6 lg:grid-cols-2">
        <!-- What the reserve is made of. Static copy, not a live figure: the
             locked public payload carries no composition field, and "100% U.S.
             dollar cash at BNI" is a statement from the official documentation
             rather than a balance. See RESERVE_COMPOSITION. -->
        <div class={`rounded-2xl ${SURFACE} p-6 sm:p-8 flex flex-col gap-6`}>
          <h2 class={sectionHeadingClass}><T t={t.reserveHeading} /></h2>
          <ul class="list-none p-0 m-0 flex flex-col gap-4">
            {composition.map((item) => (
              <li class={`flex items-baseline justify-between gap-6 border-b ${DIVIDER} pb-4 last:border-0 last:pb-0`}>
                <span class="text-white text-base leading-6"><T t={item.label} /></span>
                <span class="text-white text-base font-medium tabular-nums shrink-0">
                  {item.share ? <T t={item.share} /> : "—"}
                </span>
              </li>
            ))}
          </ul>
          <dl class={rowGridClass}>
            <dt class={rowLabelClass}><T t={t.reserveBank} /></dt>
            {/* Where the reserves are held is a fact about USDX, not a figure,
                so it is named even before the API answers — and it is named
                from the repo's constant, never from `reserve.custodian` in the
                response. The contract hardcodes that field server-side so no
                free-text staff input can carry an account number onto a public
                page; rendering the local constant means no value from the
                network reaches this line at all. The browser script does not
                touch it. */}
            <dd class={rowValueClass}>{RESERVE_BANK}</dd>

            <dt class={rowLabelClass}><T t={t.issuer} /></dt>
            <dd class={rowValueClass}>{COMPANY_LEGAL_NAME}</dd>
          </dl>
          <p class={proseClass}><T t={t.reserveCompositionNote} /></p>
        </div>

        <!-- Contract address — the first thing an explorer reviewer looks for.

             STATIC, from src/data/token.ts, and deliberately not taken from the
             API response even though the response carries a token block. There
             are two USDX deployments on Polygon mainnet, and this same static
             build is served on preview hosts that talk to the DEV backend,
             which still points at the abandoned 0x2702… deployment. Letting the
             response set this value would put a dead address under a
             USDX-branded "Contract Address" heading — the one field on this
             page a reader cannot check without being told it first, and the
             exact thing address-swap scams rely on. It changes when a human
             changes it in the repo, with DEPLOYED.md open. -->
        <div class={`rounded-2xl ${SURFACE} p-6 sm:p-8 flex flex-col gap-6`}>
          <h2 class={sectionHeadingClass}><T t={t.contractHeading} /></h2>
          <dl class={rowGridClass}>
            <dt class={rowLabelClass}><T t={ui.token.network} /></dt>
            <dd class={rowValueClass}>{tokenInfo.network}</dd>

            <dt class={rowLabelClass}><T t={ui.token.symbol} /></dt>
            <dd class={rowValueClass}>{tokenInfo.symbol}</dd>

            <dt class={rowLabelClass}><T t={ui.token.decimals} /></dt>
            <dd class={rowValueClass}>{String(tokenInfo.decimals)}</dd>
          </dl>
          <div class="flex flex-col gap-2.5">
            <span class={rowLabelClass}><T t={ui.token.contractAddress} /></span>
            {/* The one thing on this page a reader is meant to copy character
                by character, so it is set apart as a recess: black under a
                raised card, at 14px rather than 13px. */}
            <code class="block break-all rounded-lg bg-black/40 border border-white/[0.12] px-3.5 py-3 text-white text-sm leading-6 font-mono">{contractAddress}</code>
          </div>
          {explorerUrl && (
            <a
              href={explorerUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex w-fit items-center gap-2 px-4 py-2.5 rounded-lg border border-white/20 hover:border-white/40 text-white text-sm font-medium transition-colors no-underline"
            >
              <T t={ui.token.explorer} />
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5h5v5M19 5l-8 8M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
              </svg>
            </a>
          )}
        </div>
      </section>

      <!-- How the figures are read -->
      <section class={cardClass}>
        <div class="relative px-6 sm:px-10 lg:px-11 py-10 lg:py-12 flex flex-col gap-6">
          <h2 class={sectionHeadingClass}><T t={t.methodHeading} /></h2>
          {/* Two columns of running prose, so they need a gutter wide enough
              that the eye does not jump the gap mid-sentence. */}
          <div class="grid gap-x-12 gap-y-8 lg:grid-cols-2">
            <div class="flex flex-col gap-2.5">
              <h3 class="text-white text-[17px] font-semibold leading-6 m-0"><T t={t.supplyDefinitionTitle} /></h3>
              <p class={proseClass}><T t={t.supplyDefinition} /></p>
            </div>
            <div class="flex flex-col gap-2.5">
              <h3 class="text-white text-[17px] font-semibold leading-6 m-0"><T t={t.ratioDefinitionTitle} /></h3>
              <p class={proseClass}><T t={t.ratioDefinition} /></p>
            </div>
          </div>
        </div>
      </section>

      <!-- Smart contract audit -->
      <section class={cardClass}>
        <div class="relative px-6 sm:px-10 lg:px-11 py-10 lg:py-12 flex flex-col gap-5 items-start">
          <h2 class={sectionHeadingClass}><T t={t.auditHeading} /></h2>
          <p class={proseClass}><T t={t.auditBody} /></p>
          <a
            href={AUDIT_REPORT_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-primary hover:bg-primary-dark text-white text-sm font-medium transition-colors no-underline"
          >
            <T t={ui.footer.audit} />
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </section>

      <!-- Reserve attestation (AUP) — the counterpart to the audit above -->
      {/* The published attestation reports, as a table: ID, name, month, year
          and a download button per report.

          STATIC, from ATTESTATION_REPORTS in src/data/audit.ts, and rendered
          into the HTML at build time — it does not wait on the API, so a
          crawler or a reader with JavaScript off sees the same rows as everyone
          else. A report is published by adding its PDF and an entry there.

          Not the "Laporan Atestasi Bulanan" table that was removed on 30 Sep
          2026: that one was built in the browser from the API's `attestations`
          list. This page still does not read that list.

          The paragraph names its own period out loud because the live figures
          at the top of the page move, and the finding it quotes is pinned to
          27 August 2026. It describes that one report — see the note on
          ATTESTATION_REPORTS before a second row is added. */}
      <section class={cardClass}>
        <div class="relative px-6 sm:px-10 lg:px-11 py-10 lg:py-12 flex flex-col gap-6">
          <h2 class={sectionHeadingClass}><T t={t.attestationHeading} /></h2>
          {/* The page no longer says that the published file is redacted (the
              note was removed by request on 30 Sep 2026). The PDF still says so
              on the redacted page itself — see data/audit.ts. */}
          <p class={proseClass}><T t={t.attestationBody} /></p>

          <div class="overflow-x-auto -mx-2 px-2">
            {/* The header row is the only rule on the page heavier than a
                hairline. A table is read down its columns, and the reader needs
                one unambiguous line saying where the labels stop and the data
                starts. */}
            <table class="w-full border-collapse min-w-[640px]">
              <thead>
                <tr class="border-b border-white/20">
                  <th scope="col" class={`${thClass} w-20`}><T t={t.colId} /></th>
                  <th scope="col" class={thClass}><T t={t.colName} /></th>
                  <th scope="col" class={`${thClass} w-40`}><T t={t.colMonth} /></th>
                  <th scope="col" class={`${thClass} w-28`}><T t={t.colYear} /></th>
                  <th scope="col" class={`${thClass} w-36`}><T t={t.colAction} /></th>
                </tr>
              </thead>
              <tbody>
                {ATTESTATION_REPORTS.map((report) => (
                  <tr class={`border-b ${DIVIDER} last:border-0`}>
                    <td class={`${tdClass} text-white/55 tabular-nums`}>{report.id}</td>
                    <td class={`${tdClass} text-white font-medium`}><T t={report.title} /></td>
                    <td class={`${tdClass} text-white/70`}><T t={report.month} /></td>
                    <td class={`${tdClass} text-white/70 tabular-nums`}>{report.year}</td>
                    <td class={tdClass}>
                      <a
                        href={report.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary hover:bg-primary-dark text-white text-sm font-medium transition-colors no-underline"
                      >
                        <T t={t.download} />
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <Footer base="/" />
    </main>
  </div>
</Layout>

<script>
  // The BROWSER SIDE of /transparency, and deliberately nothing but wiring.
  //
  // Every decision — what a figure reads, which status line goes with them — is
  // made by pure functions in ../data/transparencyView.ts, where tests can
  // reach them. Code that lives inside this block cannot be imported, and the
  // two worst bugs this page has had both lived here for exactly that reason.
  // What is left is DOM writing: put this string in that element, show this
  // one, hide that one.
  import { ui, type Lang, type Translated } from "../i18n";
  import { resolveApiBaseUrl, TRANSPARENCY_PATH, type TransparencyEnvelope } from "../data/transparency";
  import { buildView, STATUS_LINE, type FiguresView } from "../data/transparencyView";

  const t = ui.transparency;

  /**
   * Write a value into every `[data-tp="<key>"]` slot. Translated values render
   * as the site's two `[data-l]` spans so the language switcher keeps working.
   * Always built with textContent — the API is trusted, but never trusted enough
   * to be injected as HTML.
   */
  function setValue(key: string, value: string | Translated) {
    document.querySelectorAll<HTMLElement>(`[data-tp="${key}"]`).forEach((el) => {
      if (typeof value === "string") {
        el.textContent = value;
        return;
      }
      el.replaceChildren(langSpan("id", value.id), langSpan("en", value.en));
    });
  }

  function langSpan(lang: Lang, text: string): HTMLSpanElement {
    const span = document.createElement("span");
    span.dataset.l = lang;
    span.textContent = text;
    return span;
  }

  function bilingualNode(value: Translated): DocumentFragment {
    const fragment = document.createDocumentFragment();
    fragment.append(langSpan("id", value.id), langSpan("en", value.en));
    return fragment;
  }

  function show(selector: string, visible: boolean) {
    document
      .querySelectorAll<HTMLElement>(selector)
      .forEach((el) => el.classList.toggle("hidden", !visible));
  }

  function setStatus(message: Translated) {
    const el = document.querySelector<HTMLElement>("[data-tp-status]");
    if (el) el.replaceChildren(bilingualNode(message));
  }

  // ── Figures ────────────────────────────────────────────────────────────────

  /**
   * Fill one headline figure. When the value is missing, the number reads
   * "Belum tersedia" and its unit/currency is hidden with it, so nothing on
   * screen ever reads "Belum tersedia USDX" — or, worse, "USD 0,00".
   */
  function setFigure(key: string, value: Translated | null, affix?: string) {
    setValue(key, value ?? t.notAvailable);
    if (affix) show(`[data-tp-affix="${affix}"]`, value !== null);
  }

  function applyFigures(figures: FiguresView) {
    setFigure("supply", figures.supply, "supply");
    setValue("supply-caption", figures.supplyCaption);

    setFigure("reserve", figures.reserve, "reserve");
    setValue("reserve-caption", figures.reserveCaption);

    setFigure("ratio", figures.ratio);
    if (figures.peg) setValue("peg", figures.peg);
    show("[data-tp-peg-row]", figures.peg !== null);

    setValue("updated-caption", figures.updatedCaption);

    // The unit, the currency and the bank the reserves are held at are printed
    // from the repo's own constants in the static markup, and nothing here
    // overwrites them. See the note beside RESERVE_BANK.
  }

  async function load() {
    const apiBaseUrl = resolveApiBaseUrl(window.location.hostname);
    let view: ReturnType<typeof buildView> = null;
    try {
      const response = await fetch(`${apiBaseUrl}${TRANSPARENCY_PATH}`, {
        headers: { Accept: "application/json" },
        // Public, unauthenticated endpoint — no cookies should ride along.
        credentials: "omit",
      });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const body = (await response.json()) as TransparencyEnvelope;
      view = buildView(body?.data);
      if (!view) throw new Error("empty payload");
    } catch {
      // Nothing usable arrived. Leave whatever is baked into the HTML in place
      // and say so plainly: the figure slots keep their "Belum tersedia"
      // wording rather than collapsing to zero, and every other card is static,
      // so the page stays whole.
      //
      // ONLY the fetch and the reading of it sit in this try. Rendering does
      // not, because a failure while rendering used to be reported as a failure
      // to LOAD: the figures were already on screen, filled from the response,
      // under a status line announcing that they could not be shown. Everything
      // below this point is total — buildView never throws — so the status line
      // and the screen agree.
      setStatus(t.statusFallback);
      return;
    }

    applyFigures(view.figures);
    setStatus(STATUS_LINE[view.status]);
  }

  void load();
</script>
